#!/bin/bash
#
# Primary macOS CLI for Minga.app. GUI-appropriate opens go through Launch
# Services so an existing app is reused. Terminal-only commands and --tui are
# delegated to the bundled standalone runtime without recursively invoking this
# launcher.

set -euo pipefail

resolve_script_dir() {
  local script_path="$0" link
  while [ -L "$script_path" ]; do
    link=$(readlink "$script_path")
    case "$link" in
      /*) script_path="$link" ;;
      *) script_path="$(dirname "$script_path")/$link" ;;
    esac
  done
  cd "$(dirname "$script_path")" && pwd
}

SCRIPT_DIR=$(resolve_script_dir)

bundle_app_from_script() {
  local bundle_app
  bundle_app="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd)" || true

  if [ -n "$bundle_app" ] && [ -d "$bundle_app/Contents" ]; then
    printf '%s\n' "$bundle_app"
  else
    return 1
  fi
}

valid_app() {
  [ -d "$1" ] && [ -x "$1/Contents/MacOS/Minga" ]
}

resolve_app() {
  local bundle_app

  if [ -n "${MINGA_APP_PATH:-}" ]; then
    if valid_app "$MINGA_APP_PATH"; then
      printf '%s\n' "$MINGA_APP_PATH"
      return
    fi
    return 1
  fi

  bundle_app=$(bundle_app_from_script 2>/dev/null) || true
  if [ -n "$bundle_app" ] && valid_app "$bundle_app"; then
    printf '%s\n' "$bundle_app"
  elif valid_app "/Applications/Minga.app"; then
    printf '%s\n' "/Applications/Minga.app"
  elif valid_app "$HOME/Applications/Minga.app"; then
    printf '%s\n' "$HOME/Applications/Minga.app"
  else
    return 1
  fi
}

resolve_standalone() {
  local bundle_app candidate

  if [ -n "${MINGA_STANDALONE_BIN:-}" ]; then
    if [ -x "$MINGA_STANDALONE_BIN" ]; then
      printf '%s\n' "$MINGA_STANDALONE_BIN"
      return
    fi
    return 1
  fi

  bundle_app=$(bundle_app_from_script 2>/dev/null) || true
  for candidate in \
    "${MINGA_APP_PATH:+$MINGA_APP_PATH/Contents/Resources/bin/minga-tui}" \
    "${bundle_app:+$bundle_app/Contents/Resources/bin/minga-tui}" \
    "/Applications/Minga.app/Contents/Resources/bin/minga-tui" \
    "$HOME/Applications/Minga.app/Contents/Resources/bin/minga-tui" \
    "$SCRIPT_DIR/minga-tui"
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  candidate=$(command -v minga-tui 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return
  fi

  return 1
}

show_help() {
  cat <<'EOF'
minga - BEAM-powered modal text editor

Usage: minga [options] [file|directory]
       minga --tui [options] [file|directory]

Options:
  -h, --help             Show this help message
  -v, --version          Show version
  --tui, --standalone    Run the standalone terminal UI instead of Minga.app
  --editor               Open files in the traditional editor view
  --minimal              Editor-only startup (recommended for GIT_EDITOR)
  --wait                 Wait for the target to be saved or cleanly closed
  --no-context           Don't load the file as agent context
  --safe, -Q             Start in safe mode before config loading
  --config <path>        Use a custom config file
  -D, --debug-log <path> Append messages and warnings to a debug log

Terminal-only invocations (`--headless`, `attach`, `sessions`, `detach`,
`kill-session`, and `login --manual`) automatically use the standalone runtime
and never launch Minga.app.

Examples:
  minga .
  minga README.md
  minga --editor README.md
  minga --tui README.md
  minga --wait --minimal .git/COMMIT_EDITMSG
  GIT_EDITOR='minga --wait --minimal' git commit

Wait mode accepts exactly one file. It exits 0 after a successful save or clean
close. `:cq`/`:cquit`, a discard (`:q!`), launch failure, or file-open failure
exits non-zero. The same contract works when Minga.app is already running.
EOF
}

show_version() {
  local app_path version
  app_path=$(resolve_app 2>/dev/null) || {
    echo "minga (version unknown, Minga.app not found)"
    return
  }
  version=$(/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "$app_path/Contents/Info.plist" 2>/dev/null || echo "unknown")
  echo "minga $version"
}

absolute_path() {
  local value="$1" parent
  if [[ "$value" == /* ]]; then
    printf '%s\n' "$value"
    return
  fi

  if [ -d "$value" ]; then
    (cd "$value" && pwd)
    return
  fi

  parent=$(dirname "$value")
  if [ -d "$parent" ]; then
    printf '%s/%s\n' "$(cd "$parent" && pwd)" "$(basename "$value")"
  else
    printf '%s/%s\n' "$(pwd)" "$value"
  fi
}

base64_url() {
  printf '%s' "$1" | base64 | tr -d '\n=' | tr '+/' '-_'
}

read_wait_result() {
  local result_path="$1" line status message
  IFS= read -r line < "$result_path" || line="1\tinvalid wait response"
  status="${line%%$'\t'*}"
  message="${line#*$'\t'}"

  if [ "$status" = "0" ]; then
    return 0
  fi

  if [ "$message" != "$line" ] && [ -n "$message" ]; then
    echo "minga: $message" >&2
  else
    echo "minga: editor request failed" >&2
  fi
  return 1
}

force_standalone=false
terminal_only=false
after_double_dash=false
expects_value=false
first_command=""

for arg in "$@"; do
  if $after_double_dash; then
    continue
  fi
  if $expects_value; then
    expects_value=false
    continue
  fi

  case "$arg" in
    --)
      after_double_dash=true
      ;;
    --tui|--standalone)
      force_standalone=true
      ;;
    --headless)
      terminal_only=true
      ;;
    --config|--debug-log|-D|--name|--sname|--cookie-file|--host|--port)
      expects_value=true
      ;;
    --editor|--no-context|--minimal|--safe|-Q|--wait|-h|--help|-v|--version)
      ;;
    -* )
      ;;
    *)
      if [ -z "$first_command" ]; then
        first_command="$arg"
      fi
      ;;
  esac
done

case "$first_command" in
  attach|sessions|detach|kill-session|login)
    terminal_only=true
    ;;
esac

if $force_standalone || $terminal_only; then
  standalone=$(resolve_standalone) || {
    echo "error: Minga standalone/TUI runtime not found. Install Minga.app or install the standalone minga formula." >&2
    exit 1
  }

  standalone_args=()
  after_double_dash=false
  for arg in "$@"; do
    if ! $after_double_dash && { [ "$arg" = "--tui" ] || [ "$arg" = "--standalone" ]; }; then
      continue
    fi
    standalone_args+=("$arg")
    if [ "$arg" = "--" ]; then
      after_double_dash=true
    fi
  done

  exec "$standalone" "${standalone_args[@]}"
fi

case "${1:-}" in
  -h|--help)
    show_help
    exit 0
    ;;
  -v|--version)
    show_version
    exit 0
    ;;
esac

APP_PATH=$(resolve_app) || {
  if [ -n "${MINGA_APP_PATH:-}" ]; then
    echo "error: Minga.app is missing or damaged at $MINGA_APP_PATH (expected executable Contents/MacOS/Minga)." >&2
  else
    echo "error: Minga.app not found or damaged in its bundle, /Applications, or ~/Applications." >&2
  fi
  echo "Use 'minga --tui' for standalone terminal mode." >&2
  exit 1
}

flags=()
files=()
wait_mode=false

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      show_version
      exit 0
      ;;
    --wait)
      wait_mode=true
      shift
      ;;
    --config|--debug-log|-D)
      flag="$1"
      shift
      if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
        echo "error: $flag requires a path argument" >&2
        exit 2
      fi
      flags+=("$flag" "$(absolute_path "$1")")
      shift
      ;;
    --editor|--no-context|--minimal|--safe|-Q)
      flags+=("$1")
      shift
      ;;
    --)
      shift
      while [ $# -gt 0 ]; do
        files+=("$(absolute_path "$1")")
        shift
      done
      ;;
    -*)
      echo "error: unknown flag '$1'" >&2
      exit 2
      ;;
    *)
      files+=("$(absolute_path "$1")")
      shift
      ;;
  esac
done

OPEN_BIN="${MINGA_OPEN_BIN:-/usr/bin/open}"
if [ ! -x "$OPEN_BIN" ]; then
  echo "error: cannot launch Minga.app because the macOS 'open' command is unavailable at $OPEN_BIN." >&2
  exit 1
fi

if ! $wait_mode; then
  open_args=(-a "$APP_PATH")
  if [ ${#files[@]} -gt 0 ]; then
    open_args+=("${files[@]}")
  fi
  if [ ${#flags[@]} -gt 0 ]; then
    open_args+=(--args "${flags[@]}")
  fi
  if ! "$OPEN_BIN" "${open_args[@]}"; then
    echo "error: failed to launch or hand off to Minga.app at $APP_PATH." >&2
    exit 1
  fi
  exit 0
fi

if [ ${#files[@]} -ne 1 ]; then
  echo "error: --wait requires exactly one file target" >&2
  exit 2
fi

if [ -d "${files[0]}" ]; then
  echo "error: --wait requires a file target, not a directory" >&2
  exit 2
fi

wait_root="${TMPDIR:-/tmp}"
wait_root="${wait_root%/}/minga-wait"
mkdir -p "$wait_root"
chmod 700 "$wait_root"
request_dir=$(mktemp -d "$wait_root/request.XXXXXX")
chmod 700 "$request_dir"
result_path="$request_dir/result"
ack_path="$request_dir/ack"
cleanup() { rm -rf "$request_dir"; }
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

wait_url="minga://wait/$(base64_url "$result_path")/$(base64_url "${files[0]}")"
open_args=(-a "$APP_PATH" "$wait_url")
if [ ${#flags[@]} -gt 0 ]; then
  open_args+=(--args "${flags[@]}")
fi

if ! "$OPEN_BIN" "${open_args[@]}"; then
  echo "error: failed to launch Minga.app" >&2
  exit 1
fi

# Distinguish launch/open failures from a legitimate long editing session.
# The BEAM writes ack only after the requested file is open and tracked.
attempts=0
while [ ! -e "$ack_path" ]; do
  if [ -e "$result_path" ]; then
    read_wait_result "$result_path"
    exit $?
  fi
  attempts=$((attempts + 1))
  if [ "$attempts" -ge 150 ]; then
    echo "error: Minga.app did not accept the wait request within 15 seconds" >&2
    exit 1
  fi
  "${MINGA_SLEEP_BIN:-/bin/sleep}" 0.1
done

PGREP_BIN="${MINGA_PGREP_BIN:-/usr/bin/pgrep}"
app_pid=$("$PGREP_BIN" -x Minga | /usr/bin/head -n 1 || true)
if [ -z "$app_pid" ]; then
  echo "error: Minga.app exited before the edit completed" >&2
  exit 1
fi

while [ ! -e "$result_path" ]; do
  if ! kill -0 "$app_pid" 2>/dev/null; then
    echo "error: Minga.app exited before the edit completed" >&2
    exit 1
  fi
  "${MINGA_SLEEP_BIN:-/bin/sleep}" 0.1
done

read_wait_result "$result_path"

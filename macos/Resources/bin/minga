#!/bin/bash
#
# Primary macOS CLI for Minga.app. GUI-appropriate opens go through Launch
# Services so an existing app is reused. Terminal-only commands and --tui are
# delegated to the bundled standalone runtime without recursively invoking this
# launcher.

set -euo pipefail

resolve_script_dir() {
  local script_path="$0" link
  while [ -L "$script_path" ]; do
    link=$(readlink "$script_path")
    case "$link" in
      /*) script_path="$link" ;;
      *) script_path="$(dirname "$script_path")/$link" ;;
    esac
  done
  cd "$(dirname "$script_path")" && pwd
}

SCRIPT_DIR=$(resolve_script_dir)

bundle_app_from_script() {
  local bundle_app
  bundle_app="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd)" || true

  if [ -n "$bundle_app" ] && [ -d "$bundle_app/Contents" ]; then
    printf '%s\n' "$bundle_app"
  else
    return 1
  fi
}

valid_app() {
  [ -d "$1" ] && [ -x "$1/Contents/MacOS/Minga" ]
}

resolve_app() {
  local bundle_app

  if [ -n "${MINGA_APP_PATH:-}" ]; then
    if valid_app "$MINGA_APP_PATH"; then
      printf '%s\n' "$MINGA_APP_PATH"
      return
    fi
    return 1
  fi

  bundle_app=$(bundle_app_from_script 2>/dev/null) || true
  if [ -n "$bundle_app" ] && valid_app "$bundle_app"; then
    printf '%s\n' "$bundle_app"
  elif valid_app "/Applications/Minga.app"; then
    printf '%s\n' "/Applications/Minga.app"
  elif valid_app "$HOME/Applications/Minga.app"; then
    printf '%s\n' "$HOME/Applications/Minga.app"
  else
    return 1
  fi
}

resolve_ipc() {
  local candidate

  if [ -n "${MINGA_IPC_BIN:-}" ]; then
    [ -x "$MINGA_IPC_BIN" ] || return 1
    printf '%s\n' "$MINGA_IPC_BIN"
    return
  fi

  for candidate in \
    "$APP_PATH/Contents/Resources/bin/minga-ipc" \
    "$SCRIPT_DIR/minga-ipc"
  do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  return 1
}

resolve_standalone() {
  local bundle_app candidate

  if [ -n "${MINGA_STANDALONE_BIN:-}" ]; then
    if [ -x "$MINGA_STANDALONE_BIN" ]; then
      printf '%s\n' "$MINGA_STANDALONE_BIN"
      return
    fi
    return 1
  fi

  bundle_app=$(bundle_app_from_script 2>/dev/null) || true
  for candidate in \
    "${MINGA_APP_PATH:+$MINGA_APP_PATH/Contents/Resources/bin/minga-tui}" \
    "${bundle_app:+$bundle_app/Contents/Resources/bin/minga-tui}" \
    "/Applications/Minga.app/Contents/Resources/bin/minga-tui" \
    "$HOME/Applications/Minga.app/Contents/Resources/bin/minga-tui" \
    "$SCRIPT_DIR/minga-tui"
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  candidate=$(command -v minga-tui 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return
  fi

  return 1
}

show_help() {
  cat <<'EOF'
minga - BEAM-powered modal text editor

Usage: minga [options] [file|directory]
       minga --tui [options] [file|directory]

Options:
  -h, --help             Show this help message
  -v, --version          Show version
  --tui, --standalone    Run the standalone terminal UI instead of Minga.app
  --editor               Open files in the traditional editor view
  --minimal              Editor-only startup (recommended for GIT_EDITOR)
  --wait                 Wait for the target to be saved or cleanly closed
  --no-context           Don't load the file as agent context
  --safe, -Q             Start in safe mode before config loading
  --config <path>        Use a custom config file
  -D, --debug-log <path> Append messages and warnings to a debug log

Terminal-only invocations (`--headless`, `attach`, `sessions`, `detach`,
`kill-session`, and `login --manual`) automatically use the standalone runtime
and never launch Minga.app.

Examples:
  minga .
  minga README.md
  minga --editor README.md
  minga --tui README.md
  minga --wait --minimal .git/COMMIT_EDITMSG
  GIT_EDITOR='minga --wait --minimal' git commit

Wait mode accepts exactly one file. It exits 0 after a successful save or clean
close. `:cq`/`:cquit`, a discard (`:q!`), launch failure, or file-open failure
exits non-zero. The same contract works when Minga.app is already running.
EOF
}

show_version() {
  local app_path version
  app_path=$(resolve_app 2>/dev/null) || {
    echo "minga (version unknown, Minga.app not found)"
    return
  }
  version=$(/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "$app_path/Contents/Info.plist" 2>/dev/null || echo "unknown")
  echo "minga $version"
}

absolute_path() {
  local value="$1" parent
  if [[ "$value" == /* ]]; then
    printf '%s\n' "$value"
    return
  fi

  if [ -d "$value" ]; then
    (cd "$value" && pwd)
    return
  fi

  parent=$(dirname "$value")
  if [ -d "$parent" ]; then
    printf '%s/%s\n' "$(cd "$parent" && pwd)" "$(basename "$value")"
  else
    printf '%s/%s\n' "$(pwd)" "$value"
  fi
}

force_standalone=false
terminal_only=false
after_double_dash=false
expects_value=false
first_command=""

for arg in "$@"; do
  if $after_double_dash; then
    continue
  fi
  if $expects_value; then
    expects_value=false
    continue
  fi

  case "$arg" in
    --)
      after_double_dash=true
      ;;
    --tui|--standalone)
      force_standalone=true
      ;;
    --headless)
      terminal_only=true
      ;;
    --config|--debug-log|-D|--name|--sname|--cookie-file|--host|--port)
      expects_value=true
      ;;
    --editor|--no-context|--minimal|--safe|-Q|--wait|-h|--help|-v|--version)
      ;;
    -* )
      ;;
    *)
      if [ -z "$first_command" ]; then
        first_command="$arg"
      fi
      ;;
  esac
done

case "$first_command" in
  attach|sessions|detach|kill-session|login)
    terminal_only=true
    ;;
esac

if $force_standalone || $terminal_only; then
  standalone=$(resolve_standalone) || {
    echo "error: Minga standalone/TUI runtime not found. Install Minga.app or install the standalone minga formula." >&2
    exit 1
  }

  standalone_args=()
  after_double_dash=false
  for arg in "$@"; do
    if ! $after_double_dash && { [ "$arg" = "--tui" ] || [ "$arg" = "--standalone" ]; }; then
      continue
    fi
    standalone_args+=("$arg")
    if [ "$arg" = "--" ]; then
      after_double_dash=true
    fi
  done

  exec "$standalone" "${standalone_args[@]}"
fi

case "${1:-}" in
  -h|--help)
    show_help
    exit 0
    ;;
  -v|--version)
    show_version
    exit 0
    ;;
esac

APP_PATH=$(resolve_app) || {
  if [ -n "${MINGA_APP_PATH:-}" ]; then
    echo "error: Minga.app is missing or damaged at $MINGA_APP_PATH (expected executable Contents/MacOS/Minga)." >&2
  else
    echo "error: Minga.app not found or damaged in its bundle, /Applications, or ~/Applications." >&2
  fi
  echo "Use 'minga --tui' for standalone terminal mode." >&2
  exit 1
}

flags=()
startup_flags=()
files=()
wait_mode=false
request_editor=false

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      show_version
      exit 0
      ;;
    --wait)
      wait_mode=true
      shift
      ;;
    --config|--debug-log|-D)
      flag="$1"
      shift
      if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
        echo "error: $flag requires a path argument" >&2
        exit 2
      fi
      flags+=("$flag" "$(absolute_path "$1")")
      startup_flags+=("$flag")
      shift
      ;;
    --editor)
      flags+=("$1")
      request_editor=true
      shift
      ;;
    --no-context|--minimal|--safe|-Q)
      flags+=("$1")
      startup_flags+=("$1")
      shift
      ;;
    --)
      shift
      while [ $# -gt 0 ]; do
        files+=("$(absolute_path "$1")")
        shift
      done
      ;;
    -*)
      echo "error: unknown flag '$1'" >&2
      exit 2
      ;;
    *)
      files+=("$(absolute_path "$1")")
      shift
      ;;
  esac
done

OPEN_BIN="${MINGA_OPEN_BIN:-/usr/bin/open}"
if [ ! -x "$OPEN_BIN" ]; then
  echo "error: cannot launch Minga.app because the macOS 'open' command is unavailable at $OPEN_BIN." >&2
  exit 1
fi

IPC_BIN=$(resolve_ipc) || {
  echo "error: Minga.app is missing its authenticated native IPC helper." >&2
  exit 1
}

endpoint_exists=false
if "$IPC_BIN" probe >/dev/null 2>&1; then
  endpoint_exists=true
else
  probe_status=$?
  case "$probe_status" in
    3|5) ;; # missing, stale, or lost-before-acceptance endpoint: start a fresh app
    4)
      echo "error: the existing Minga.app IPC endpoint failed security validation." >&2
      exit 1
      ;;
    *)
      echo "error: could not inspect the Minga.app IPC endpoint." >&2
      exit 1
      ;;
  esac
fi

if $endpoint_exists && [ ${#startup_flags[@]} -gt 0 ]; then
  rejected=$(IFS=', '; printf '%s' "${startup_flags[*]}")
  echo "error: startup-only flag(s) cannot be applied to the running Minga.app: $rejected" >&2
  echo "Quit Minga.app first, then retry." >&2
  exit 2
fi

retry_after_endpoint_loss=false

if ! $wait_mode; then
  if $endpoint_exists; then
    if ! "$OPEN_BIN" -a "$APP_PATH"; then
      echo "error: failed to activate Minga.app" >&2
      exit 1
    fi
    if [ ${#files[@]} -gt 0 ]; then
      ipc_args=(open)
      if $request_editor; then ipc_args+=(--editor); fi
      if "$IPC_BIN" "${ipc_args[@]}" "${files[@]}"; then
        exit 0
      else
        ipc_status=$?
      fi
      if [ "$ipc_status" -ne 5 ]; then
        exit "$ipc_status"
      fi
      # The endpoint proven by probe died before accepting the request. Relaunch
      # exactly once with a nonce; the retried helper is exec'd below, so a
      # second pre-acceptance loss is terminal rather than recursive.
      retry_after_endpoint_loss=true
    else
      exit 0
    fi
  fi

  if [ ${#startup_flags[@]} -gt 0 ] || $request_editor || $retry_after_endpoint_loss; then
    launch_nonce=$("$IPC_BIN" nonce) || {
      echo "error: could not create a launch nonce" >&2
      exit 1
    }
    open_args=(-a "$APP_PATH" --args)
    if [ ${#flags[@]} -gt 0 ]; then
      open_args+=("${flags[@]}")
    fi
    open_args+=(--minga-launch-nonce "$launch_nonce")

    if ! "$OPEN_BIN" "${open_args[@]}"; then
      echo "error: failed to launch Minga.app" >&2
      exit 1
    fi

    ipc_identity_args=(--expected-launch-nonce "$launch_nonce")
    if [ ${#startup_flags[@]} -eq 0 ]; then
      ipc_identity_args+=(--allow-launch-conflict)
    fi

    if [ ${#files[@]} -gt 0 ]; then
      ipc_args=(open "${ipc_identity_args[@]}")
      if $request_editor; then ipc_args+=(--editor); fi
      exec "$IPC_BIN" "${ipc_args[@]}" "${files[@]}"
    fi

    if ! "$IPC_BIN" probe "${ipc_identity_args[@]}"; then
      if [ ${#startup_flags[@]} -gt 0 ]; then
        echo "error: another Minga.app instance won startup; requested startup-only flags were not applied." >&2
      else
        echo "error: Minga.app did not publish an authenticated IPC endpoint." >&2
      fi
      exit 1
    fi
    exit 0
  fi

  open_args=(-a "$APP_PATH")
  if [ ${#files[@]} -gt 0 ]; then
    open_args+=("${files[@]}")
  fi
  if ! "$OPEN_BIN" "${open_args[@]}"; then
    echo "error: failed to launch or hand off to Minga.app at $APP_PATH." >&2
    exit 1
  fi
  exit 0
fi

if [ ${#files[@]} -ne 1 ]; then
  echo "error: --wait requires exactly one file target" >&2
  exit 2
fi

if [ -d "${files[0]}" ]; then
  echo "error: --wait requires a file target, not a directory" >&2
  exit 2
fi

trap 'exit 130' HUP INT TERM

if $endpoint_exists; then
  if ! "$OPEN_BIN" -a "$APP_PATH"; then
    echo "error: failed to activate Minga.app" >&2
    exit 1
  fi
  ipc_args=(wait)
  if $request_editor; then ipc_args+=(--editor); fi
  if "$IPC_BIN" "${ipc_args[@]}" "${files[0]}"; then
    exit 0
  else
    ipc_status=$?
  fi
  if [ "$ipc_status" -ne 5 ]; then
    exit "$ipc_status"
  fi
  # Exit 5 can only be emitted before the accepted frame. Once accepted, the
  # helper maps exact app death to terminal exit 1 and this launcher never
  # relaunches or transfers the wait request to a different app instance.
fi

launch_nonce=$("$IPC_BIN" nonce) || {
  echo "error: could not create a launch nonce" >&2
  exit 1
}
open_args=(-a "$APP_PATH" --args)
if [ ${#flags[@]} -gt 0 ]; then
  open_args+=("${flags[@]}")
fi
open_args+=(--minga-launch-nonce "$launch_nonce")

if ! "$OPEN_BIN" "${open_args[@]}"; then
  echo "error: failed to launch Minga.app" >&2
  exit 1
fi

ipc_args=(wait --expected-launch-nonce "$launch_nonce")
if [ ${#startup_flags[@]} -eq 0 ]; then
  ipc_args+=(--allow-launch-conflict)
fi
if $request_editor; then ipc_args+=(--editor); fi
exec "$IPC_BIN" "${ipc_args[@]}" "${files[0]}"

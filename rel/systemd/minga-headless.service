[Unit]
Description=Minga headless agent daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/minga --headless
WorkingDirectory=%h
Restart=on-failure
RestartSec=5
Environment=MIX_ENV=prod
# Set one stable cookie before the release VM boots. The same value is read by
# the CLI distribution preflight. Prefer a mode-0600 EnvironmentFile in production.
Environment=RELEASE_COOKIE=__CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES__
# Optional provider credentials live on the server, not on attaching clients.
# Environment=ANTHROPIC_API_KEY=...
# Environment=OPENAI_API_KEY=...

[Install]
WantedBy=default.target

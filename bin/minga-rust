#!/usr/bin/env bash
# Development launcher for Minga with the Rust TUI renderer.
#
# Usage:
#   bin/minga-rust [filename]
#
# Starts the BEAM editor core first and has BEAM spawn the Rust frontend as a
# Port. Rust uses MINGA_TTY or /dev/tty for terminal I/O and stdin/stdout for
# the packet protocol.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

(cd "$PROJECT_DIR" && mix native.build.support && mix native.build.rust_tui)

export MINGA_TUI_IMPL=rust
export MINGA_SKIP_NATIVE_LAUNCH_BUILD=1

exec "$PROJECT_DIR/bin/minga" "$@"

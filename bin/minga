#!/usr/bin/env bash
# Launch Minga with editor-tuned BEAM flags.
#
# Usage:
#   bin/minga [filename]
#   bin/minga +gui [filename]
#
# Override any flag via ERL_FLAGS:
#   ERL_FLAGS="+S 2:2" bin/minga README.md

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -z "${MINGA_TTY:-}" ] && command -v tty >/dev/null 2>&1; then
  DETECTED_TTY="$(tty 2>/dev/null || true)"
  if [ -n "$DETECTED_TTY" ] && [ "$DETECTED_TTY" != "not a tty" ]; then
    export MINGA_TTY="$DETECTED_TTY"
  fi
fi

if [ "${MINGA_SKIP_NATIVE_LAUNCH_BUILD:-}" != "1" ]; then
  if [ "${1:-}" = "+gui" ]; then
    (cd "$PROJECT_DIR" && mix native.build.support)
  else
    (cd "$PROJECT_DIR" && mix native.build.tui)
  fi
fi

# Editor-tuned VM flags, shared with bin/minga-dev (see rel/vm.args.eex).
# ERL_FLAGS set by the caller are appended, so they can override.
# shellcheck source=bin/lib/erl-flags.sh
source "$PROJECT_DIR/bin/lib/erl-flags.sh"

should_redirect_stdio() {
  if [ "${MINGA_DISABLE_LAUNCH_STDIO_REDIRECT:-}" = "1" ]; then
    return 1
  fi

  local args=("$@")
  local first=""
  local i=0
  while [ "$i" -lt "${#args[@]}" ]; do
    local arg="${args[$i]}"
    case "$arg" in
      +gui|--headless|--minimal|--safe|-Q|--editor|--help|-h|--version|-v)
        return 1
        ;;
      --config|--debug-log|-D|--name|--sname|--cookie-file|--host|--port)
        i=$((i + 2))
        continue
        ;;
      --no-context)
        i=$((i + 1))
        continue
        ;;
      *)
        first="$arg"
        break
        ;;
    esac
  done

  case "$first" in
    sessions|detach|kill-session|login)
      return 1
      ;;
  esac

  return 0
}

if should_redirect_stdio "$@"; then
  LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/minga"
  mkdir -p "$LOG_DIR"
  exec mix minga "$@" >> "$LOG_DIR/minga.log" 2>&1
else
  exec mix minga "$@"
fi

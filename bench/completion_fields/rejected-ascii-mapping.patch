@@ -1,8 +1,10 @@
 defmodule Minga.Editing.Completion.IndexTest do
   use ExUnit.Case, async: true
+  use ExUnitProperties
 
   alias Minga.Editing.Completion.Index
   alias Minga.Editing.Completion.Item
+  alias Minga.Editing.Completion.Ranker
 
   defp item(provider, label, fields \\ %{}) do
     Item.from_lsp(provider, Map.merge(%{"label" => label}, fields))
@@ -142,4 +144,115 @@ defmodule Minga.Editing.Completion.IndexTest do
     assert [_, _] = snapshot.items
     assert Enum.any?(snapshot.items, &(&1.id == selected.id))
   end
+
+  # Labels mix ASCII, precomposed and decomposed accents, expanding and context-sensitive case
+  # mappings (İ, Σ, ß, ǅ), CJK and emoji, so per-codepoint and whole-string lowercase disagree.
+  @label_codepoints ~w(a b e x _ A E X É é \u0301 İ Σ ς ß ǅ 字 段 😀)
+
+  property "retained match ranges equal the recorded label mapping control" do
+    check all(
+            labels <- list_of(label(), min_length: 1, max_length: 12),
+            filter_overrides <- list_of(boolean(), length: length(labels)),
+            query <- query_for(labels),
+            max_runs: 500
+          ) do
+      items =
+        labels
+        |> Enum.zip(filter_overrides)
+        |> Enum.with_index()
+        |> Enum.map(fn {{label, override?}, n} ->
+          fields = %{"label" => label, "sortText" => String.pad_leading("#{n}", 3, "0")}
+          fields = if override?, do: Map.put(fields, "filterText", "f" <> label), else: fields
+          item(:provider, label, fields)
+        end)
+
+      normalized_query = String.downcase(query)
+
+      for retained <- Index.snapshot(Index.from_items(items), query).items do
+        {:ok, score} = Ranker.score(normalized_query, retained.search.filter_text)
+        ranges = Ranker.match_ranges(normalized_query, retained.search.filter_text, score)
+
+        assert retained.match_ranges == eager_label_ranges(retained, ranges)
+      end
+    end
+  end
+
+  defp label do
+    @label_codepoints
+    |> member_of()
+    |> list_of(min_length: 1, max_length: 8)
+    |> map(&Enum.join/1)
+  end
+
+  defp query_for(labels) do
+    one_of([
+      constant(""),
+      labels |> member_of() |> bind(&prefix_of/1),
+      labels |> member_of() |> bind(&subsequence_of/1),
+      label()
+    ])
+  end
+
+  defp prefix_of(label) do
+    codepoints = label |> String.downcase() |> String.codepoints()
+    map(integer(1..length(codepoints)), &(codepoints |> Enum.take(&1) |> Enum.join()))
+  end
+
+  defp subsequence_of(label) do
+    codepoints = label |> String.downcase() |> String.codepoints()
+
+    codepoints
+    |> length()
+    |> then(&list_of(boolean(), length: &1))
+    |> map(fn keep ->
+      codepoints |> Enum.zip(keep) |> Enum.filter(&elem(&1, 1)) |> Enum.map_join(&elem(&1, 0))
+    end)
+  end
+
+  # Control: the label mapping as it was before #3497, kept verbatim. It lowercases every codepoint
+  # with `String.downcase/1`, and snapshots map ranges through it and cap them at 255.
+  defp eager_label_ranges(item, ranges) do
+    mapping =
+      eager_mapping(item.label, item.filter_text, item.search.label, item.search.filter_text)
+
+    mapping |> eager_map_ranges(ranges) |> Enum.take(255)
+  end
+
+  defp eager_mapping(label, label, normalized, normalized) do
+    label |> String.to_charlist() |> eager_prefix(normalized, 0, [])
+  end
+
+  defp eager_mapping(_label, _filter_text, _normalized_label, _normalized_filter_text), do: nil
+
+  defp eager_prefix([], "", _offset, offsets), do: Enum.reverse(offsets)
+  defp eager_prefix([], _suffix, _offset, _offsets), do: nil
+
+  defp eager_prefix([codepoint | rest], normalized, offset, offsets) do
+    part = String.downcase(<<codepoint::utf8>>)
+    size = byte_size(part)
+
+    case normalized do
+      <<^part::binary-size(^size), suffix::binary>> ->
+        offsets = eager_offsets(part, offset, offsets)
+        eager_prefix(rest, suffix, offset + 1, offsets)
+
+      _ ->
+        nil
+    end
+  end
+
+  defp eager_offsets("", _offset, offsets), do: offsets
+
+  defp eager_offsets(<<_codepoint::utf8, rest::binary>>, offset, offsets),
+    do: eager_offsets(rest, offset, [offset | offsets])
+
+  defp eager_map_ranges(nil, _ranges), do: []
+
+  defp eager_map_ranges(mapping, ranges) do
+    ranges
+    |> Enum.flat_map(fn {start, length} -> Enum.slice(mapping, start, length) end)
+    |> Enum.uniq()
+    |> Enum.sort()
+    |> Item.compact_match_positions()
+  end
 end
diff --git a/test/minga_editor/completion_field_contract_test.exs b/test/minga_editor/completion_field_contract_test.exs
new file mode 100644
index 000000000..573eaf104
--- /dev/null
+++ b/test/minga_editor/completion_field_contract_test.exs
@@ -0,0 +1,287 @@
+defmodule MingaEditor.CompletionFieldContractTest do
+  @moduledoc """
+  Consumer-boundary contract for completion field preparation (#3497).
+
+  A production-shaped LSP response goes through the same steps the Editor uses: `ProviderBatch.from_response/6` (the completion Task), `Session.accept_batch/2`, `Completion.new/3` and `Completion.filter/2` (installation), `CompletionBuilder.build/1` (the popup model), and `Completion.accept/1`. The expected values were recorded on the commit before #3497 and are the control: changing how fields are prepared must not change ranking, identity, match ranges, displayed details and documentation, resolve attachment, or the accepted edit.
+  """
+
+  use ExUnit.Case, async: true
+
+  alias Minga.Editing.Completion
+  alias Minga.Editing.Completion.Item
+  alias Minga.Editing.Completion.ProviderBatch
+  alias Minga.Editing.Completion.Session
+  alias MingaEditor.RenderModel.UI.CompletionBuilder
+
+  @provider :contract_lsp
+  @trigger {1, 4}
+
+  @long_doc String.duplicate("Handles the event — ünïcödé docs.\n\n    iex> handle(1)\n\n", 80)
+
+  # Labels cover ASCII, precomposed accents, CJK, an emoji with an uppercase start, a Greek final
+  # sigma whose label cannot map (per-codepoint lowercase differs), and a filterText override.
+  defp raw_items do
+    [
+      raw("handle_event", "0003", doc: markdown(@long_doc), edit: :range, additional: true),
+      raw("handle_évènement", "0001", doc: "  plain évènement docs  ", edit: :insert_replace),
+      raw("handle_字段", "0002", edit: :range, additional: true),
+      raw("Handle😀Emoji", "0004", doc: markdown("emoji docs"), edit: :insert_text),
+      raw("handleΣΑΣ", "0005", doc: markdown("sigma docs"), edit: :range),
+      raw("display_only", "0000", filter: "handle_alt", doc: markdown("alt docs"), edit: :range),
+      raw("unrelated", "0006", doc: markdown("unrelated docs"), edit: :range)
+    ]
+  end
+
+  defp raw(label, sort, opts) do
+    base = %{
+      "label" => label,
+      "kind" => 3,
+      "detail" => "#{label}(term()) :: :ok",
+      "sortText" => sort,
+      "insertTextFormat" => 2,
+      "data" => %{"id" => label}
+    }
+
+    base
+    |> put_if(opts[:filter], "filterText", opts[:filter])
+    |> put_if(opts[:doc], "documentation", opts[:doc])
+    |> put_edit(label, opts[:edit])
+    |> put_if(opts[:additional], "additionalTextEdits", [
+      %{"range" => range(0, 0, 0, 0), "newText" => "alias Contract.#{sort}\n"}
+    ])
+  end
+
+  defp put_if(map, nil, _key, _value), do: map
+  defp put_if(map, _present, key, value), do: Map.put(map, key, value)
+
+  defp put_edit(map, label, :range),
+    do: Map.put(map, "textEdit", %{"range" => range(1, 4, 1, 7), "newText" => snippet(label)})
+
+  defp put_edit(map, label, :insert_replace) do
+    Map.put(map, "textEdit", %{
+      "insert" => range(1, 4, 1, 7),
+      "replace" => range(1, 4, 1, 9),
+      "newText" => snippet(label)
+    })
+  end
+
+  defp put_edit(map, label, :insert_text), do: Map.put(map, "insertText", snippet(label))
+
+  defp snippet(label), do: "#{label}(${1:event})$0"
+  defp markdown(value), do: %{"kind" => "markdown", "value" => "\n#{value}\n"}
+
+  defp range(sl, sc, el, ec) do
+    %{"start" => %{"line" => sl, "character" => sc}, "end" => %{"line" => el, "character" => ec}}
+  end
+
+  # Installs the response the way `install_session_completion/3` does and filters to `prefix`.
+  defp install(raw_items, prefix) do
+    session = Session.new(make_ref(), 1, self(), 0, @trigger)
+    request_ref = make_ref()
+    session = Session.register_requests(session, [{@provider, self(), request_ref}])
+
+    batch =
+      ProviderBatch.from_response(session.id, 1, @provider, self(), request_ref, %{
+        "isIncomplete" => false,
+        "items" => raw_items
+      })
+
+    {:ok, session} = Session.accept_batch(session, batch)
+
+    completion =
+      session
+      |> Session.index()
+      |> Completion.new(@trigger, session.selected_item_id)
+      |> Completion.filter(prefix)
+
+    {session, completion}
+  end
+
+  defp model(completion) do
+    CompletionBuilder.build(%{
+      completion: completion,
+      windows: %{active: 1, map: %{}},
+      layout: %{window_layouts: %{1 => %{content: {0, 0, 80, 24}}}}
+    })
+  end
+
+  defp labels_and_ranges(completion),
+    do: Enum.map(completion.filtered, &{&1.label, &1.match_ranges})
+
+  defp move(completion, 0), do: completion
+  defp move(completion, n), do: completion |> Completion.move_down() |> move(n - 1)
+
+  describe "ranking, filtering and identity" do
+    test "rank order, counts and label match ranges match the recorded control" do
+      {_session, completion} = install(raw_items(), "h")
+
+      assert labels_and_ranges(completion) == [
+               {"display_only", []},
+               {"handle_évènement", [{0, 1}]},
+               {"handle_字段", [{0, 1}]},
+               {"handle_event", [{0, 1}]},
+               {"Handle😀Emoji", [{0, 1}]},
+               {"handleΣΑΣ", [{0, 1}]}
+             ]
+
+      assert {completion.total_count, completion.matched_count} == {7, 6}
+
+      typed = Completion.filter(completion, "handle_é")
+      assert labels_and_ranges(typed) == [{"handle_évènement", [{0, 8}]}]
+
+      fuzzy = Completion.filter(completion, "hdlev")
+
+      assert labels_and_ranges(fuzzy) == [
+               {"handle_évènement", [{0, 1}, {3, 3}, {8, 1}]},
+               {"handle_event", [{0, 1}, {3, 3}, {8, 1}]}
+             ]
+    end
+
+    test "item identity does not depend on preparation and survives refiltering" do
+      {_session, completion} = install(raw_items(), "h")
+
+      expected =
+        Map.new(raw_items(), fn raw ->
+          item = Item.from_lsp(@provider, raw)
+          {item.label, Item.wire_id(item)}
+        end)
+
+      for item <- completion.filtered, do: assert(Item.wire_id(item) == expected[item.label])
+
+      selected = Completion.selected_item(move(completion, 2))
+      refiltered = Completion.filter(move(completion, 2), "handle")
+      assert Completion.selected_item(refiltered).id == selected.id
+    end
+
+    test "the visible model carries match ranges and wire ids for every visible item" do
+      {_session, completion} = install(raw_items(), "handle_")
+      model = model(completion)
+
+      assert Enum.map(model.items, &{&1.label, &1.match_ranges}) == [
+               {"display_only", []},
+               {"handle_évènement", [%{start: 0, length: 7}]},
+               {"handle_字段", [%{start: 0, length: 7}]},
+               {"handle_event", [%{start: 0, length: 7}]}
+             ]
+
+      assert Enum.map(model.items, & &1.id) == Enum.map(completion.filtered, &Item.wire_id/1)
+    end
+  end
+
+  describe "selected details and documentation" do
+    test "each selection move shows that item's detail and trimmed documentation" do
+      {_session, completion} = install(raw_items(), "h")
+
+      shown =
+        for n <- 0..5 do
+          moved = move(completion, n)
+          model = model(moved)
+          selected = Completion.selected_item(moved)
+          assert model.selected_item_id == Item.wire_id(selected)
+          assert Enum.at(model.items, model.selected_offset).detail == selected.detail
+          {selected.label, model.documentation}
+        end
+
+      assert shown == [
+               {"display_only", "alt docs"},
+               {"handle_évènement", "plain évènement docs"},
+               {"handle_字段", ""},
+               {"handle_event", binary_part(String.trim(@long_doc), 0, 4096)},
+               {"Handle😀Emoji", "emoji docs"},
+               {"handleΣΑΣ", "sigma docs"}
+             ]
+    end
+  end
+
+  describe "resolve" do
+    test "resolved documentation attaches only to the exact selected identity" do
+      {session, completion} = install(raw_items(), "h")
+      undocumented = Completion.selected_item(move(completion, 2))
+      assert undocumented.label == "handle_字段"
+      assert undocumented.documentation == ""
+
+      session = Session.select(session, undocumented.id)
+      identity = {session.id, @provider, undocumented.id}
+      {:ok, session} = Session.begin_resolve(session, undocumented.id, self(), nil)
+      resolve_ref = make_ref()
+      {:ok, session} = Session.track_resolve(session, identity, resolve_ref)
+
+      # A response for a superseded request, or for another item, never attaches.
+      assert Session.resolve_item(session, identity, make_ref(), "stale") == :stale
+      other = Completion.selected_item(completion)
+      other_identity = {session.id, @provider, other.id}
+      assert Session.resolve_item(session, other_identity, resolve_ref, "wrong") == :stale
+
+      {:ok, resolved} = Session.resolve_item(session, identity, resolve_ref, "resolved docs")
+
+      reinstalled =
+        resolved
+        |> Session.index()
+        |> Completion.new(@trigger, resolved.selected_item_id)
+        |> Completion.filter("h")
+
+      assert Completion.selected_item(reinstalled).id == undocumented.id
+      assert model(reinstalled).documentation == "resolved docs"
+      assert labels_and_ranges(reinstalled) == labels_and_ranges(completion)
+
+      documentation = Map.new(reinstalled.filtered, &{&1.label, &1.documentation})
+      assert documentation["handle_évènement"] == "plain évènement docs"
+      assert documentation["handle_字段"] == "resolved docs"
+    end
+
+    test "a resolve for the previous selection is stale after the selection changes" do
+      {session, completion} = install(raw_items(), "h")
+      first = Completion.selected_item(move(completion, 2))
+      second = Completion.selected_item(move(completion, 3))
+
+      session = Session.select(session, first.id)
+      {:ok, session} = Session.begin_resolve(session, first.id, self(), nil)
+      first_identity = {session.id, @provider, first.id}
+      first_ref = make_ref()
+      {:ok, session} = Session.track_resolve(session, first_identity, first_ref)
+
+      session = Session.select(session, second.id)
+      {:ok, session} = Session.begin_resolve(session, second.id, self(), nil)
+
+      assert Session.resolve_item(session, first_identity, first_ref, "late") == :stale
+      assert Session.find_item(session, first.id).documentation == ""
+    end
+  end
+
+  describe "acceptance" do
+    test "accepting a text edit returns the selected item's snippet-free edit" do
+      {_session, completion} = install(raw_items(), "h")
+      selected = move(completion, 3)
+      assert Completion.selected_item(selected).label == "handle_event"
+
+      assert Completion.accept(selected) ==
+               {:text_edit,
+                %{
+                  range: %{start_line: 1, start_col: 4, end_line: 1, end_col: 7},
+                  new_text: "handle_event(event)"
+                }}
+    end
+
+    test "an InsertReplaceEdit accepts its insert range and insertText accepts text" do
+      {_session, completion} = install(raw_items(), "h")
+
+      assert Completion.accept(move(completion, 1)) ==
+               {:text_edit,
+                %{
+                  range: %{start_line: 1, start_col: 4, end_line: 1, end_col: 7},
+                  new_text: "handle_évènement(event)"
+                }}
+
+      assert Completion.accept(move(completion, 4)) == {:insert_text, "Handle😀Emoji(event)"}
+    end
+
+    test "additional text edits stay attached to the accepted item unprepared" do
+      {_session, completion} = install(raw_items(), "h")
+      accepted = Completion.selected_item(move(completion, 3))
+
+      assert accepted.raw["additionalTextEdits"] == [
+               %{"range" => range(0, 0, 0, 0), "newText" => "alias Contract.0003\n"}
+             ]
+    end
+  end
+end

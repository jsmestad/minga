[order, outcome | fixture_args] = System.argv()
input = IO.binread(:standard_io, :eof)

{stdout, stderr, exit_code} =
  case outcome do
    "success" ->
      {"formatted:" <> input, "formatter warning: optional setting ignored\n", 0}

    "empty" ->
      {"", "formatter warning: empty result\n", 0}

    "failure" ->
      {"partial formatter output\n", "formatter failed: invalid source\n", 7}

    "large" ->
      {String.duplicate("o", 131_072), String.duplicate("e", 131_072), 0}

    "barrier-success" ->
      [port] = fixture_args

      {:ok, socket} =
        :gen_tcp.connect({127, 0, 0, 1}, String.to_integer(port), [
          :binary,
          packet: :line,
          active: false
        ])

      :ok = :gen_tcp.send(socket, "ready\n")
      {:ok, "release\n"} = :gen_tcp.recv(socket, 0, 5_000)
      :ok = :gen_tcp.close(socket)
      {"formatted:" <> input, "", 0}
  end

write_streams = fn ->
  case order do
    "stdout-first" ->
      IO.binwrite(:standard_io, stdout)
      IO.binwrite(:stderr, stderr)

    "stderr-first" ->
      IO.binwrite(:stderr, stderr)
      IO.binwrite(:standard_io, stdout)
  end
end

write_streams.()
System.halt(exit_code)

#!/usr/bin/env python3
"""Render the Arch PKGBUILD for one published Linux release.

The same recipe builds minga-bin for the AUR and minga for Minga's own pacman
repository. It downloads the release's own Linux tarballs and pins their
SHA-256 digests, so makepkg verifies the exact bytes the release published.
"""

import argparse
import re
import sys

REPOSITORY = "jsmestad/minga"

PKGBUILD = """\
# Maintainer: Minga contributors <16150+jsmestad@users.noreply.github.com>
#
# Generated by scripts/render-aur-pkgbuild in https://github.com/{repository}
# for one published release. The next release overwrites changes made here.

pkgname={pkgname}
_release={release}
pkgver={pkgver}
pkgrel=1
pkgdesc='BEAM-powered modal text editor for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/{repository}'
license=('MIT')
depends=('glibc>=2.39' 'bash' 'coreutils')
{relations}options=('!strip' '!debug')
source=("LICENSE-$_release::https://raw.githubusercontent.com/{repository}/{source_sha}/LICENSE")
source_x86_64=("https://github.com/{repository}/releases/download/v$_release/minga_${{_release}}_linux_x86_64.tar.gz")
source_aarch64=("https://github.com/{repository}/releases/download/v$_release/minga_${{_release}}_linux_aarch64.tar.gz")
sha256sums=('{license_sha256}')
sha256sums_x86_64=('{x86_64_sha256}')
sha256sums_aarch64=('{aarch64_sha256}')

prepare() {{
  local erts='' version='' extra=''
  # Mix writes this two-field record without a terminating newline.
  read -r erts version extra < minga/releases/start_erl.data || [[ -n $version ]] || return 1
  [[ -n $erts && $version == "$_release" && -z $extra && -x minga/launchers/minga ]]
}}

package() {{
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/lib"
  cp -a minga "$pkgdir/usr/lib/"
  ln -s ../lib/minga/launchers/minga "$pkgdir/usr/bin/minga"
  install -Dm644 "LICENSE-$_release" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}}
"""


def pacman_version(release):
    """Map a release version to a pkgver that pacman sorts correctly.

    pkgver cannot contain a hyphen. pacman sorts a trailing letter run before
    the end of the string, so 0.1.0dev.N is older than 0.1.0. A separator before
    the letters (0.1.0.devN or 0.1.0_devN) would sort newer than 0.1.0.
    """
    match = re.fullmatch(r"([0-9]+\.[0-9]+\.[0-9]+)(?:-dev\.([1-9][0-9]*))?", release)
    if not match:
        raise ValueError("version must be X.Y.Z or a rolling X.Y.Z-dev.N")
    base, build = match.groups()
    return base if build is None else f"{base}dev.{build}"


# The AUR package and the repository package install the same files, so each excludes the other.
RELATIONS = {
    "minga-bin": "provides=('minga')\nconflicts=('minga')\n",
    "minga": "conflicts=('minga-bin')\n",
}


def render(release, source_sha, x86_64_sha256, aarch64_sha256, license_sha256, pkgname="minga-bin"):
    if not re.fullmatch(r"[0-9a-f]{40}", source_sha):
        raise ValueError("source SHA must be a full lowercase 40-character commit SHA")
    for name, digest in (("x86_64", x86_64_sha256), ("aarch64", aarch64_sha256), ("LICENSE", license_sha256)):
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError(f"{name} SHA-256 must be 64 lowercase hexadecimal characters")
    if pkgname not in RELATIONS:
        raise ValueError(f"package name must be one of {', '.join(RELATIONS)}")
    return PKGBUILD.format(
        repository=REPOSITORY, pkgname=pkgname, relations=RELATIONS[pkgname], release=release, pkgver=pacman_version(release), source_sha=source_sha,
        x86_64_sha256=x86_64_sha256, aarch64_sha256=aarch64_sha256, license_sha256=license_sha256,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", required=True, help="release version, such as 0.1.0-dev.123")
    parser.add_argument("--source-sha", required=True, help="commit the release was built from")
    parser.add_argument("--x86-64-sha256", required=True)
    parser.add_argument("--aarch64-sha256", required=True)
    parser.add_argument("--license-sha256", required=True)
    parser.add_argument("--pkgname", default="minga-bin", choices=RELATIONS,
                        help="minga-bin for the AUR (default) or minga for Minga's pacman repository")
    args = parser.parse_args()
    try:
        sys.stdout.write(render(args.version, args.source_sha, args.x86_64_sha256,
                                args.aarch64_sha256, args.license_sha256, args.pkgname))
    except ValueError as error:
        parser.exit(1, f"{parser.prog}: {error}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Repackage a qualified Ubuntu 24.04 TUI archive as a local Debian package."""

import argparse
import gzip
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import tempfile
import zlib
from shutil import copyfile


TARGETS = {"amd64": "linux_x86_64", "arm64": "linux_aarch64"}
CHECKER = Path(__file__).resolve().with_name("check-release-contents")

# The Ubuntu 24.04 runtime receipt and checker allow only the system loader
# and glibc SONAMEs. OpenSSL and SQLite are bundled; the shell and its tools
# are Debian Essential packages and do not need to be declared here.
CONTROL = """Package: minga
Version: {version}
Architecture: {arch}
Section: editors
Priority: optional
Maintainer: Minga contributors <16150+jsmestad@users.noreply.github.com>
Depends: libc6 (>= 2.39)
Homepage: https://github.com/jsmestad/minga
Description: Minga modal editor (terminal interface)
"""


def unpack_release(source, destination):
    seen = set()
    payload_bytes = 0

    def release_member(member, root):
        nonlocal payload_bytes
        parts = member.name.split("/")
        if (parts[0] != "minga" or any(part in ("", ".", "..") for part in parts)
                or any(ord(character) < 32 for character in member.name)):
            raise ValueError(f"Unsafe archive path: {member.name!r}")
        if member.name in seen:
            raise ValueError(f"Duplicate archive path: {member.name!r}")
        if (member.type not in (tarfile.DIRTYPE, tarfile.REGTYPE, tarfile.AREGTYPE)
                or member.issparse() or member.mode & 0o7000):
            raise ValueError(f"Archive contains links, special files or privileged modes: {member.name!r}")
        if len(parts) == 1 and not member.isdir():
            raise ValueError("Archive root must be the minga directory")
        if member.size < 0 or (member.isdir() and member.size != 0):
            raise ValueError(f"Invalid archive member size: {member.name!r}")
        payload_bytes += member.size
        if len(seen) >= 200_000 or payload_bytes > 4 * 1024**3:
            raise ValueError("Archive exceeds release extraction limits")
        seen.add(member.name)
        mode = 0o755 if member.isdir() or member.mode & 0o100 else 0o644
        return tarfile.data_filter(member, root).replace(mode=mode)

    if not source.is_file():
        raise ValueError(f"Not a release archive file: {source}")
    with gzip.open(source, "rb") as compressed:
        with tarfile.open(fileobj=compressed, mode="r:", errorlevel=2) as archive:
            for member in archive:
                archive.extract(member, destination, filter=release_member)
            # tarfile stops at the first end marker. Read through the gzip
            # trailer and require a complete tar end marker, with only padding.
            compressed.seek(archive.offset)
            block = tarfile.BLOCKSIZE
            max_tail = tarfile.RECORDSIZE + block
            tail = compressed.read(max_tail + 1)
            if not 2 * block <= len(tail) <= max_tail or len(tail) % block or any(tail):
                raise ValueError("Invalid end of release archive")
    if "minga" not in seen:
        raise ValueError("Archive is missing the minga root directory")


def build(source, version, arch, output):
    if not re.fullmatch(r"[0-9][0-9A-Za-z.+~\-]*", version):
        raise ValueError("Version must start with a digit and be Debian-compatible")
    # Make staging directories accessible after installation regardless of the
    # caller's umask. TemporaryDirectory itself stays private.
    os.umask(0o022)
    with tempfile.TemporaryDirectory(prefix="minga-deb-") as temporary:
        package = Path(temporary) / "package"
        private = package / "usr/lib"
        private.mkdir(parents=True)
        unpack_release(source, private)
        release = private / "minga"
        subprocess.run([sys.executable, CHECKER, release, "--target", TARGETS[arch]], check=True)
        _, release_version = (release / "releases/start_erl.data").read_text().split()
        if release_version != version:
            raise ValueError(f"Archive version {release_version!r} does not match --version {version!r}")

        public = package / "usr/bin"
        public.mkdir()
        (public / "minga").symlink_to("../lib/minga/launchers/minga")
        copyright_file = package / "usr/share/doc/minga/copyright"
        copyright_file.parent.mkdir(parents=True)
        copyfile(CHECKER.parent.parent / "LICENSE", copyright_file)
        control = package / "DEBIAN"
        control.mkdir()
        (control / "control").write_text(CONTROL.format(version=version, arch=arch), encoding="utf-8")

        output.mkdir(parents=True, exist_ok=True)
        final = output / f"minga_{version}_{arch}.deb"
        # Publish only the completed package, keeping any previous output intact on failure.
        with tempfile.TemporaryDirectory(prefix=".minga-deb-", dir=output) as build_dir:
            staged = Path(build_dir) / final.name
            subprocess.run(["dpkg-deb", "--root-owner-group", "--build", package, staged], check=True)
            staged.replace(final)
        return final


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("archive", type=Path, help="final native Linux TUI .tar.gz")
    parser.add_argument("--version", required=True, help="the version in the release metadata")
    parser.add_argument("--arch", required=True, choices=TARGETS, help="Debian target architecture")
    parser.add_argument("--output", type=Path, required=True, help="output directory")
    args = parser.parse_args()
    try:
        print(build(args.archive, args.version, args.arch, args.output))
    except (OSError, ValueError, EOFError, OverflowError, tarfile.TarError,
            zlib.error, subprocess.CalledProcessError) as error:
        print(f"Debian package build failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

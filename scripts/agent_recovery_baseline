#!/usr/bin/env bash
set -euo pipefail

# Invoke with bash, no executable-bit or permission changes are required.
cd "$(dirname "$0")/.."
root=$(mktemp -d /tmp/minga-agent-recovery-XXXXXXXX)
printf 'Evidence retained at %s\n' "$root"
trap 'code=$?; printf "exit_status=%s\n" "$code" > "$root/exit-status.txt"' EXIT
preflight() {
  [[ $# == 0 || ( $# == 2 && ${1:-} == --scenario && -n ${2:-} ) ]] || { echo 'FAIL: Usage: bash scripts/agent_recovery_baseline [--scenario NAME]' >&2; return 64; }
  [[ $(uname -s) == Linux ]] || { echo 'FAIL: Linux /proc and pidfd support required' >&2; return 1; }
  for tool in git python3 mix erl zig; do
    command -v "$tool" >/dev/null || { echo "FAIL: missing prerequisite $tool" >&2; return 1; }
  done
  resolve() {
    if command -v asdf >/dev/null && [[ $1 != git && $1 != python3 ]]; then
      asdf which "$1"
    else
      command -v "$1"
    fi
  }
  mix=$(resolve mix) || return
  erl=$(resolve erl) || return
  zig=$(resolve zig) || return
  python=$(resolve python3) || return
  archives=${MIX_ARCHIVES:-$HOME/.mix/archives}
  [[ -d "$archives" ]] || { echo 'FAIL: install Hex with mix local.hex before running the corpus' >&2; return 1; }
  tool_path="$(dirname "$mix"):$(dirname "$erl"):$(dirname "$zig"):$(dirname "$python"):/usr/bin:/bin"
  revision=$(env -i PATH="$tool_path" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git rev-parse --verify HEAD) || return
  printf '%s\n' "$revision" > "$root/revision.txt" || return
  mkdir -p "$root"/{home,config,data,cache,state,tmp} || return
}
if preflight "$@" > "$root/prerequisites.log" 2>&1; then
  cat "$root/prerequisites.log"
else
  code=$?
  cat "$root/prerequisites.log" >&2
  exit "$code"
fi

# No inherited credentials, proxy settings, SSH agent, Erlang distribution or user config.
# Only the source tree, installed toolchain and existing dependency/build caches are reused.
set +e
env -i PATH="$tool_path" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
  HOME="$root/home" XDG_CONFIG_HOME="$root/config" XDG_DATA_HOME="$root/data" \
  XDG_CACHE_HOME="$root/cache" XDG_STATE_HOME="$root/state" TMPDIR="$root/tmp" \
  MIX_ENV=dev MIX_ARCHIVES="$archives" LANG=C.UTF-8 ERL_FLAGS='+S 4:4' PYTHONDONTWRITEBYTECODE=1 \
  MINGA_RECOVERY_ROOT="$root" MINGA_RECOVERY_REVISION="$revision" \
  "$mix" run --no-start scripts/agent_recovery_baseline.exs "$@" 2>&1 | tee "$root/runtime.log"
statuses=("${PIPESTATUS[@]}")
code=${statuses[0]}
if [[ ${statuses[1]} != 0 ]]; then
  printf 'FAIL: recording runtime evidence through tee failed (status %s)\n' "${statuses[1]}" >&2
  code=1
fi
set -e
printf 'Corpus exit status: %s; evidence: %s\n' "$code" "$root"
exit "$code"

#!/usr/bin/env python3
"""Run bare units, isolated hosted focus suites, and external approval geometry."""

import argparse
import hashlib
import math
import os
import json
import re
import plistlib
import subprocess
import signal
import struct
import sys
import tempfile
import time
import uuid
from pathlib import Path


POLICY = "EditorFocusPolicyTests"
REPLAY = "FocusReplayWindowTests"
SUITE_NAMES = {POLICY: "Editor focus policy", REPLAY: "Focus corpus in a production window"}
REPLAY_CASES = {
    "picker_open_close", "search_open_close", "rename_confirm", "rename_cancel",
    "agent_toggle", "reattach_keyframe", "hover_and_empty",
}
POLICY_FUNCTIONS = {
    "pickerBeforeKeyWindow", "promptAfterNativeModal", "inlineHierarchyRebuild",
    "keyframeRestoresOwner", "nativeFieldDefersOwner", "dismantlingFieldAppliesPendingOwner",
    "markedTextDefersOwner", "localLeasesDeferLatestOwner", "iconSearchMirrorFocusesNativeField",
    "lifecycleAppliesOnlyDecodedOwner", "inlineStemSelectionPrecedesTyping",
    "productionInlineRebuildDoesNotCommit", "productionFieldsRegisterAfterLateInjection",
}
GEOMETRY_WIDTHS = (220, 320, 760)
GEOMETRY_LABELS = {"Approve (y)", "Trust for session (a)", "Trust for this turn (t)", "Deny (n)"}


def node_text(node):
    return " ".join(str(node.get(key, "")) for key in ("nodeIdentifier", "nodeIdentifierURL", "name"))


def records(value, ancestors=()):
    """Retain suite ancestry while consuming xcresulttool's actual test tree."""
    if isinstance(value, dict):
        if "nodeType" in value:
            ancestors = (*ancestors, value)
            yield value, ancestors
        for child in value.values():
            yield from records(child, ancestors)
    elif isinstance(value, list):
        for child in value:
            yield from records(child, ancestors)


def belongs_to(ancestors, suite):
    return any(suite in node_text(node) or node.get("name") == SUITE_NAMES[suite] for node in ancestors)


def validate_action(name, summary, tests, log, exit_code):
    """Classify real results, never a successful command or visibility inference."""
    errors = []
    if exit_code != 0:
        errors.append(f"Native action exited {exit_code}")
    if not isinstance(summary, dict) or not isinstance(tests, dict):
        errors.append("Missing readable xcresult summary or test tree")
        return errors, []
    for key in ("totalTestCount", "passedTests", "failedTests"):
        if type(summary.get(key)) is not int or summary[key] < 0:
            errors.append(f"Missing or invalid summary count: {key}")
    if summary.get("totalTestCount", 0) == 0 or summary.get("passedTests", 0) == 0:
        errors.append("No passed tests were executed")
    if summary.get("failedTests") != 0 or summary.get("result") != "Passed":
        errors.append("xcresult summary did not pass")
    nodes = list(records(tests))
    if not nodes:
        errors.append("Empty xcresult test tree")
    failures = [node for node, _ in nodes if str(node.get("result", "")).lower() in ("failed", "failure", "error", "skipped")]
    if failures:
        errors.append("Failed test or suite (or skipped execution) in xcresult: " + ", ".join(dict.fromkeys(node.get("nodeIdentifier") or node.get("name") or node["nodeType"] for node in failures)))

    pids = sorted({int(pid) for pid in re.findall(r"\[Focus application .+?\] startup pid=(\d+)\b", log)})
    if name == "ordinary":
        if any(belongs_to(ancestors, suite) for _, ancestors in nodes for suite in (POLICY, REPLAY)):
            errors.append("Ordinary action included an isolated focus suite")
        if pids:
            errors.append("Ordinary action launched a focus application scope")
        return errors, pids

    suite = POLICY if name == "focus-policy" else REPLAY
    selected = [node for node, ancestors in nodes if belongs_to(ancestors, suite)]
    if not selected:
        errors.append(f"Selected suite was not enumerated: {suite}")
    other = REPLAY if suite == POLICY else POLICY
    if any(belongs_to(ancestors, other) for _, ancestors in nodes):
        errors.append(f"Focus action included the other isolated suite: {other}")
    for node, ancestors in nodes:
        if node.get("result") == "Passed" and node.get("nodeType") in ("Test Case", "Test Case Run", "Arguments") and not belongs_to(ancestors, suite):
            errors.append("Focus action executed an unrelated test: " + node_text(node))
    if len(pids) != 1:
        errors.append(f"Expected exactly one observed focus test-runner PID, got {pids}")

    passed = [node for node in selected if node.get("result") == "Passed"]
    if suite == POLICY:
        observed = set()
        for node in passed:
            match = re.search(r"(?:^|/)EditorFocusPolicyTests/([A-Za-z0-9_]+)\(\)$", node.get("nodeIdentifier", ""))
            if node.get("nodeType") == "Test Case" and match:
                observed.add(match.group(1))
            elif node.get("nodeType") == "Test Case":
                errors.append("Policy contains an unrelated execution identifier: " + node_text(node))
        if observed != POLICY_FUNCTIONS:
            errors.append(f"Policy requires all 13 own passed functions; missing={sorted(POLICY_FUNCTIONS - observed)}, unexpected={sorted(observed - POLICY_FUNCTIONS)}")
    else:
        enumerated = any("corpusIsEnumerated" in node_text(node) or "focus scenarios are enumerated for both consumers" in node_text(node) for node in passed)
        replayed = any("replay(" in node_text(node) or "same shared frames establish responder and AX identity" in node_text(node) for node in passed)
        # Global summary counts describe logical functions, not argument runs.
        # Require the actual pinned-Xcode named argument receipts instead.
        observed = {
            node.get("name") for node, ancestors in nodes
            if node.get("nodeType") == "Arguments" and node.get("result") == "Passed"
            and belongs_to(ancestors, REPLAY)
            and any("replay(" in node_text(parent) for parent in ancestors)
        }
        if not enumerated or not replayed or observed != REPLAY_CASES:
            errors.append(f"Replay must pass enumeration and all seven cases; observed cases={sorted(observed)}, passedTests={summary.get('passedTests')}")
    return errors, pids


def canonical_path(value):
    """Resolve symlinks in absolute execution paths, retaining empty/invalid sentinels."""
    if isinstance(value, str) and value and Path(value).is_absolute():
        return str(Path(value).resolve())
    return value


def validate_build_identity(settings, products, hosted):
    targets = [item.get("buildSettings", {}) for item in settings if item.get("target") == "MingaTests"] if isinstance(settings, list) else []
    if len(targets) != 1:
        return ["Missing unique MingaTests build-settings identity"]
    target = targets[0]
    host = products / "Debug/MingaTestHost.app/Contents/MacOS/MingaTestHost"
    bundle = products / ("Debug/MingaTestHost.app/Contents/PlugIns/MingaTests.xctest" if hosted else "Debug/MingaTests.xctest")
    errors = []
    expected_host = canonical_path(str(host)) if hosted else ""
    if any(canonical_path(target.get(key, "")) != expected_host for key in ("TEST_HOST", "BUNDLE_LOADER")):
        errors.append("Wrong resolved TEST_HOST/BUNDLE_LOADER execution identity")
    actual_bundle = Path(target.get("TARGET_BUILD_DIR", "")) / target.get("FULL_PRODUCT_NAME", "")
    if not actual_bundle.is_absolute() or actual_bundle.resolve() != bundle.resolve():
        errors.append(f"Wrong actual test-bundle placement: {actual_bundle}; expected {bundle}")
    if not bundle.is_dir() or (hosted and not host.is_file()):
        errors.append("Expected bare/hosted test product is missing from the observed build location")
    return errors


def validate_execution_identity(settings, log, products, hosted):
    errors = validate_build_identity(settings, products, hosted)
    host = products / "Debug/MingaTestHost.app/Contents/MacOS/MingaTestHost"
    host_pids = set(re.findall(r"\[MingaTestHost\] didFinishLaunching pid=(\d+)", log))
    scope_pids = set(re.findall(r"\[Focus application .+?\] startup pid=(\d+)\b", log))
    if hosted:
        runtime_hosts = {canonical_path(path.rstrip()) for path in re.findall(r"bundle=com\.minga\.test-host executable=([^\r\n]+)", log)}
        if len(host_pids) != 1 or host_pids != scope_pids or runtime_hosts != {canonical_path(str(host))}:
            errors.append("Missing or contradictory actual host/scope runtime identity")
    elif host_pids or scope_pids or not re.search(r"\bxctest\[\d+:", log):
        errors.append("Missing genuine bare xctest runtime identity (or observed an application host)")
    return errors


def snapshot_plans(products, destination):
    destination.mkdir()
    receipts = {}
    for path in sorted(products.glob("*.xctestrun")):
        data = path.read_bytes()
        copy = destination / path.name
        copy.write_bytes(data)
        receipts[str(path)] = {"signature": [path.stat().st_mtime_ns, len(data), hashlib.sha256(data).hexdigest()], "copy": str(copy)}
    (destination / "receipts.json").write_text(json.dumps(receipts, indent=2) + "\n")
    return receipts


def plan_target(plan):
    if not isinstance(plan, dict):
        raise ValueError("Plan is not an xctestrun dictionary")
    if plan.get("__xctestrun_metadata__", {}).get("FormatVersion") != 1:
        raise ValueError("Plan must use the emitted MingaUnitTests xctestrun format 1")
    targets = {key: value for key, value in plan.items() if key != "__xctestrun_metadata__"}
    if set(targets) != {"MingaTests"} or not isinstance(targets["MingaTests"], dict) or targets["MingaTests"].get("BlueprintName") != "MingaTests":
        raise ValueError("Plan must select exactly the MingaTests target")
    return targets["MingaTests"]


def validate_hosted_plan(plan, products):
    target = plan_target(plan)
    host_bundle = products / "Debug/MingaTestHost.app"
    bundle = host_bundle / "Contents/PlugIns/MingaTests.xctest"
    def resolve(value):
        return canonical_path(str(value).replace("__TESTROOT__", str(products)).replace("__TESTHOST__", str(host_bundle)).replace("$(BUILT_PRODUCTS_DIR)", str(products / "Debug")))
    if resolve(target.get("TestHostPath", "")) != canonical_path(str(host_bundle)) or resolve(target.get("TestBundlePath", "")) != canonical_path(str(bundle)):
        raise ValueError("Plan has wrong hosted application bundle or test bundle")
    if target.get("IsAppHostedTestBundle") is False or target.get("IsUITestBundle", False):
        raise ValueError("Plan contradicts hosted unit-test execution")
    environments = [target.get(key, {}) for key in ("EnvironmentVariables", "TestingEnvironmentVariables")]
    app_paths = {resolve(env["MINGA_TEST_PRODUCTION_APP_PATH"]) for env in environments if "MINGA_TEST_PRODUCTION_APP_PATH" in env}
    if app_paths != {canonical_path(str(products / "Debug/Minga.app"))}:
        raise ValueError("Plan has missing or wrong production-app environment")


def select_hosted_plan(before, after, products, build_success):
    if not build_success:
        raise ValueError("Focus dependency failed: current hosted build did not pass")
    matches, rejected = [], []
    for source, receipt in after.items():
        name = Path(source).name
        if name != "MingaUnitTests.xctestrun" and not name.startswith("MingaUnitTests_"):
            continue
        try:
            if receipt["signature"] == before.get(source, {}).get("signature"):
                raise ValueError("stale plan, unchanged by current policy build")
            plan = plistlib.loads(Path(receipt["copy"]).read_bytes())
            validate_hosted_plan(plan, products)
            matches.append((source, plan))
        except (ValueError, OSError, plistlib.InvalidFileException) as error:
            rejected.append(f"{source}: {error}")
    if len(matches) != 1:
        raise ValueError(f"Expected one current hosted MingaUnitTests plan, got {len(matches)}; rejected={rejected}")
    return matches[0]


def pin_focus_plan(plan, products, destination, suite):
    # Bind only the relocation-sensitive root, retaining Xcode's other placeholders.
    def bind(value):
        if isinstance(value, str):
            return value.replace("__TESTROOT__", str(products))
        if isinstance(value, list):
            return [bind(child) for child in value]
        if isinstance(value, dict):
            return {key: bind(child) for key, child in value.items()}
        return value
    pinned = bind(plan)
    target = plan_target(pinned)
    target.pop("SkipTestIdentifiers", None)
    target["OnlyTestIdentifiers"] = [suite]
    with destination.open("wb") as stream:
        plistlib.dump(pinned, stream)
    return pinned


def capture_build_settings(common, overrides, destination, cwd):
    command = ["xcodebuild", "build-for-testing", *common, *overrides, "-destination", "platform=macOS", "-showBuildSettings", "-json"]
    stderr = destination.with_suffix(".log")
    probe = {"command": command, "stdout": str(destination), "stderr": str(stderr), "exit_code": None, "error": None}
    with destination.open("w") as output, stderr.open("w") as errors:
        try:
            process = subprocess.run(command, cwd=cwd, stdout=output, stderr=errors, check=False)
            probe["exit_code"] = process.returncode
        except OSError as error:
            errors.write(str(error) + "\n")
            probe["error"] = f"Could not execute build-settings probe: {error}"
            return probe, None
    if process.returncode != 0:
        probe["error"] = f"Build-settings probe exited {process.returncode}"
        return probe, None
    try:
        value = json.loads(destination.read_text())
    except (ValueError, OSError) as error:
        probe["error"] = f"Could not read/decode build-settings probe JSON: {error}"
        return probe, None
    return probe, value


def prepare_hosted_policy(common, products, run, cwd):
    before = snapshot_plans(products, run / "policy-plans-before")
    command = ["xcodebuild", "build-for-testing", *common, "-destination", "platform=macOS"]
    log = run / "focus-policy.build.log"
    execution_error = None
    with log.open("w") as stream:
        try:
            exit_code = subprocess.run(command, cwd=cwd, stdout=stream, stderr=subprocess.STDOUT, check=False).returncode
        except OSError as error:
            execution_error = str(error)
            stream.write(execution_error + "\n")
            exit_code = 127
    after = snapshot_plans(products, run / "policy-plans-after")
    settings_path = run / "focus-policy.build-settings.json"
    probe, settings = capture_build_settings(common, [], settings_path, cwd)
    receipt = {
        "build": {"command": command, "log": str(log.relative_to(run.parent)), "executed": True, "exit_code": exit_code, "execution_error": execution_error},
        "settings": str(settings_path.relative_to(run.parent)), "settings_command": probe["command"], "settings_probe": probe,
        "plans_before": str((run / "policy-plans-before/receipts.json").relative_to(run.parent)),
        "plans_after": str((run / "policy-plans-after/receipts.json").relative_to(run.parent)),
    }
    errors = validate_build_identity(settings, products, True)
    if exit_code != 0:
        errors.append(f"Hosted policy build exited {exit_code}; log={log}")
    if probe["error"]:
        errors.append(f"focus-policy: {probe['error']}; JSON={probe['stdout']}; stderr={probe['stderr']}")
    policy_plan = None
    try:
        source, plan = select_hosted_plan(before, after, products, exit_code == 0)
        receipt["source_plan"] = source
        if not errors:
            path = run / "focus-policy.xctestrun"
            policy_plan = pin_focus_plan(plan, products, path, POLICY)
            receipt["policy_plan"] = str(path.relative_to(run.parent))
    except (ValueError, OSError) as error:
        errors.append(str(error))
    return settings, receipt, errors, policy_plan


def extract_result(bundle, kind, destination):
    command = ["xcrun", "xcresulttool", "get", "test-results", kind, "--path", str(bundle)]
    with destination.open("w") as output, destination.with_suffix(".log").open("w") as errors:
        try:
            process = subprocess.run(command, stdout=output, stderr=errors, check=False)
        except OSError as error:
            errors.write(str(error) + "\n")
            return None
    if process.returncode != 0:
        return None
    try:
        value = json.loads(destination.read_text())
        return value if isinstance(value, dict) else None
    except (ValueError, OSError):
        return None


def geometry_manifest(paths):
    """Bind this finite test's inputs/products without relying on a dirty Git revision."""
    files = set()
    for path in paths:
        if not path.exists():
            raise ValueError(f"Missing geometry input/product: {path}")
        if path.is_dir():
            files.update(item for item in path.rglob("*") if item.is_file())
        else:
            files.add(path)
    return {str(path.resolve()): hashlib.sha256(path.read_bytes()).hexdigest() for path in sorted(files)}


def geometry_json(path):
    if not path.is_file() or path.stat().st_size > 1_048_576:
        raise ValueError(f"Missing or oversized geometry receipt: {path}")
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"Geometry receipt is not an object: {path}")
    return value


def geometry_finite(value):
    if type(value) not in (int, float):
        return False
    try:
        return math.isfinite(value)
    except OverflowError:
        return False


def geometry_frame(value):
    if not isinstance(value, dict) or set(value) != {"x", "y", "width", "height"} or not all(geometry_finite(value[key]) for key in value):
        return False
    right, bottom = value["x"] + value["width"], value["y"] + value["height"]
    return value["width"] > 0 and value["height"] > 0 and geometry_finite(right) and geometry_finite(bottom) and right > value["x"] and bottom > value["y"]


def geometry_contains(outer, inner):
    return inner["x"] >= outer["x"] - 0.5 and inner["y"] >= outer["y"] - 0.5 and (
        inner["x"] + inner["width"] <= outer["x"] + outer["width"] + 0.5
    ) and inner["y"] + inner["height"] <= outer["y"] + outer["height"] + 0.5


def validate_geometry_observation(value, directory, run_id, width, observer_pid, observer, host, host_pid):
    """Accept real external observations, never a command exit or an invented XCTest count."""
    errors = []
    if value.get("schema") != "minga-approval-geometry-v2" or value.get("run_id") != run_id or value.get("width") != width:
        return ["infrastructure: stale or mismatched geometry observation"], False
    if value.get("kind") != "observation":
        return [f"infrastructure: geometry acquisition failed: {value.get('failure')}"], False
    identity, capture = value.get("host"), value.get("capture")
    if not all(isinstance(item, dict) for item in (identity, capture)):
        return ["infrastructure: missing host or capture identity"], False
    if value.get("observer_pid") != observer_pid or canonical_path(value.get("observer_executable")) != str(observer.resolve()):
        errors.append("infrastructure: observer execution identity does not match the launched product")
    if type(identity.get("pid")) is not int or identity["pid"] != host_pid or canonical_path(identity.get("executable")) != str(host.resolve()) or identity.get("bundle_identifier") != "com.minga.test-host":
        errors.append("infrastructure: wrong owned host identity")
    if value.get("hit_oracle") != "system-wide-AX-hit-test":
        errors.append("infrastructure: wrong external button hit-test oracle")
    try:
        ready = geometry_json(directory / "host-ready.json")
        if ready.get("schema") != "minga-approval-host-v1" or ready.get("run_id") != run_id or ready.get("width") != width:
            raise ValueError("Host readiness belongs to another schema/run/width")
        if any(ready.get(key) != identity.get(key) for key in ("pid", "executable", "bundle_identifier", "window_id")):
            raise ValueError("Host-ready receipt contradicts the external host observation")
    except (OSError, ValueError) as error:
        errors.append(f"infrastructure: {error}")
    bounds, scale = capture.get("point_bounds"), capture.get("scale")
    captured = False
    try:
        if capture.get("filename") != "window.png" or capture.get("api") != "ScreenCaptureKit.SCScreenshotManager.desktopIndependentWindow":
            raise ValueError("Missing exact owned-window capture")
        if type(identity.get("window_id")) is not int or identity["window_id"] <= 0 or capture.get("window_id") != identity["window_id"] or capture.get("host_pid") != identity.get("pid"):
            raise ValueError("Capture belongs to a different window/process")
        if not geometry_frame(bounds) or not geometry_finite(scale) or scale <= 0:
            raise ValueError("Invalid native capture bounds/scale")
        ax_bounds = capture.get("ax_window_bounds")
        if not geometry_frame(ax_bounds) or not geometry_contains(bounds, ax_bounds):
            raise ValueError("The compositor capture does not contain its externally observed AX window")
        image = directory / "window.png"
        if not image.is_file() or not 24 <= image.stat().st_size <= 64 * 1024 * 1024:
            raise ValueError("Missing or oversized retained PNG")
        data = image.read_bytes()
        if data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR" or hashlib.sha256(data).hexdigest() != capture.get("sha256"):
            raise ValueError("Retained PNG is corrupt or differs from the ImageIO-decoded bytes")
        pixels = struct.unpack(">II", data[16:24])
        dimensions = tuple(bounds[key] * scale for key in ("width", "height"))
        if not all(geometry_finite(dimension) and 0 < dimension <= 0x7FFFFFFF for dimension in dimensions):
            raise ValueError("Invalid native-scale PNG dimensions")
        expected = tuple(int(math.floor(dimension + 0.5)) for dimension in dimensions)
        if pixels != expected or pixels != (capture.get("pixel_width"), capture.get("pixel_height")) or pixels != (capture.get("decoded_pixel_width"), capture.get("decoded_pixel_height")):
            raise ValueError("PNG/native-scale/ImageIO-decoded dimensions disagree")
        captured = True
    except (OSError, ValueError) as error:
        errors.append(f"infrastructure: {error}")
    workspace, buttons = value.get("workspace"), value.get("buttons")
    if value.get("workspace_count") != 1 or not geometry_frame(workspace):
        errors.append("assertion: expected one externally exposed positive workspace frame")
        return errors, captured
    if abs(workspace["width"] - width) > 0.5:
        errors.append(f"assertion: actual workspace width is not {width} points")
    if geometry_frame(bounds) and not geometry_contains(bounds, workspace):
        errors.append("assertion: workspace escapes the captured owned window")
    if not isinstance(buttons, list) or any(not isinstance(button, dict) for button in buttons):
        errors.append("assertion: missing external button observations")
        return errors, captured
    titles = [button.get("title") for button in buttons]
    if len(buttons) != 4 or any(not isinstance(title, str) for title in titles) or set(titles) != GEOMETRY_LABELS:
        errors.append("assertion: expected all four exact approval controls, without duplicates")
    valid = []
    for button in buttons:
        title, frame, label_width = button.get("title"), button.get("frame"), button.get("label_width")
        if button.get("title_attribute") not in ("AXTitle", "AXDescription") or button.get("role") != "AXButton" or any(button.get(key) is not True for key in ("enabled", "press_capable", "center_hits_exact_button")):
            errors.append(f"assertion: {title!r} is not an enabled, press-capable, externally hittable native button")
        if not geometry_frame(frame):
            errors.append(f"assertion: {title!r} has no positive finite external frame")
            continue
        valid.append(frame)
        if not geometry_contains(workspace, frame):
            errors.append(f"assertion: {title!r} escapes the workspace")
        if not geometry_finite(label_width) or label_width <= 0 or frame["width"] + 0.5 < label_width:
            errors.append(f"assertion: {title!r} cannot fit its actual native-font label width")
    for index, left in enumerate(valid):
        for right in valid[index + 1:]:
            if min(left["x"] + left["width"], right["x"] + right["width"]) - max(left["x"], right["x"]) > 0.5 and min(left["y"] + left["height"], right["y"] + right["height"]) - max(left["y"], right["y"]) > 0.5:
                errors.append("assertion: approval controls overlap")
    return errors, captured


def geometry_process_record(process, executable, pgid, cleanup=False):
    if process is None:
        status = "not_launched"
    elif cleanup:
        status = "terminated_reaped" if type(process.returncode) is int else "failed"
    else:
        status = "launched"
    return {
        "executable": str(executable.resolve()),
        "pid": process.pid if process is not None else None,
        "pgid": pgid,
        "status": status,
        "return_code": process.returncode if cleanup and process is not None else None,
    }


def validate_geometry_lifecycle(launch, cleanup, expected):
    """Compare persisted facts to retained Popen identities, never use receipts as process authority."""
    errors = []
    for record, schema in ((launch, "minga-approval-geometry-launch-v2"), (cleanup, "minga-approval-geometry-cleanup-v1")):
        if not isinstance(record, dict) or record.get("schema") != schema:
            errors.append("infrastructure: missing or wrong geometry lifecycle schema")
            continue
        if any(record.get(key) != expected[key] for key in ("run_id", "width", "supervisor_pid")):
            errors.append("infrastructure: stale or mismatched geometry lifecycle")
        for role in ("host", "observer"):
            actual, owner = record.get(role), expected[role]
            if not isinstance(actual, dict) or any(actual.get(key) != owner[key] for key in ("pid", "pgid", "executable")):
                errors.append(f"infrastructure: {role} lifecycle contradicts its owned process")
                continue
            if owner["pid"] is None:
                if actual.get("status") != "not_launched" or any(actual.get(key) is not None for key in ("pid", "pgid", "return_code")):
                    errors.append(f"infrastructure: {role} falsely claims it was not launched")
            elif type(owner["pid"]) is not int or owner["pid"] <= 1 or owner["pgid"] != owner["pid"]:
                errors.append(f"infrastructure: {role} lacks its fresh process-group identity")
            elif schema.endswith("launch-v2"):
                if actual.get("status") != "launched" or actual.get("return_code") is not None:
                    errors.append(f"infrastructure: {role} has contradictory launch facts")
            elif actual.get("status") != "terminated_reaped" or type(actual.get("return_code")) is not int or type(owner["return_code"]) is not int or actual["return_code"] != owner["return_code"]:
                errors.append(f"infrastructure: {role} termination/reap was not observed")
    if not isinstance(cleanup, dict) or cleanup.get("descriptors_closed") is not True or cleanup.get("errors") != []:
        errors.append("infrastructure: geometry cleanup or descriptor closure is incomplete")
    return errors


def stop_geometry_process(process, role, errors, grace):
    if process is None:
        return
    exited = process.poll()
    if exited is not None:
        if role == "host" and exited != 0:
            errors.append(f"host exited unexpectedly before cleanup: {exited}")
        return
    try:
        process.terminate()
    except ProcessLookupError:
        pass  # Still require wait/reap below.
    except OSError as error:
        errors.append(f"{role} TERM failed: {error}")
    try:
        process.wait(timeout=grace)
        return
    except subprocess.TimeoutExpired:
        pass
    except OSError as error:
        errors.append(f"{role} graceful wait failed: {error}")
    try:
        process.kill()
    except ProcessLookupError:
        pass  # Still require wait/reap below.
    except OSError as error:
        errors.append(f"{role} KILL failed: {error}")
    try:
        process.wait(timeout=grace)
    except (OSError, subprocess.TimeoutExpired) as error:
        errors.append(f"{role} final wait/reap failed: {error}")


def run_geometry_case(case, receipt, observer, host, cancelled, timeout=60, grace=2):
    """Own both exact children and every descriptor through one unconditional cleanup path."""
    processes = {"host": None, "observer": None}
    groups = {"host": None, "observer": None}
    executables = {"host": host, "observer": observer}
    common = {"run_id": receipt["run_id"], "width": receipt["width"], "supervisor_pid": os.getpid()}
    errors, cleanup_errors, logs = receipt["validation_errors"], [], []
    receipt.update({"observed": False, "captured": False, "success": False, "cleanup_verified": False})
    receipt["launch"] = {"schema": "minga-approval-geometry-launch-v2", **common, **{
        role: geometry_process_record(None, executables[role], None) for role in processes
    }}
    try:
        case.mkdir()
        host_log, observer_log = case / "host.log", case / "observer.log"
        logs.append(host_log.open("w"))
        logs.append(observer_log.open("w"))
        if cancelled() is not None:
            raise ValueError("Geometry cancelled before host launch")
        processes["host"] = subprocess.Popen(
            [str(host)], stdin=subprocess.PIPE, stdout=logs[0], stderr=subprocess.STDOUT,
            env={"MINGA_TEST_APPROVAL_WIDTH": str(receipt["width"]), "MINGA_APPROVAL_GEOMETRY_RUN_ID": receipt["run_id"], "MINGA_APPROVAL_GEOMETRY_READY": str((case / "host-ready.json").resolve())},
            start_new_session=True,
        )
        groups["host"] = os.getpgid(processes["host"].pid)
        receipt["launch"]["host"] = geometry_process_record(processes["host"], host, groups["host"])
        if cancelled() is not None:
            raise ValueError("Geometry cancelled after host launch")
        command = [
            str(observer), "--host-pid", str(processes["host"].pid), "--host-executable", str(host.resolve()),
            "--ready-file", str((case / "host-ready.json").resolve()), "--width", str(receipt["width"]),
            "--run-id", receipt["run_id"], "--output-dir", str(case.resolve()),
        ]
        receipt["command"] = command
        processes["observer"] = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=logs[1], stderr=subprocess.STDOUT, start_new_session=True)
        groups["observer"] = os.getpgid(processes["observer"].pid)
        receipt["launch"]["observer"] = geometry_process_record(processes["observer"], observer, groups["observer"])
        deadline = time.monotonic() + timeout
        while True:
            if cancelled() is not None:
                raise ValueError("Geometry cancelled during acquisition")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(command, timeout)
            try:
                processes["observer"].wait(timeout=min(0.1, remaining))
                break
            except subprocess.TimeoutExpired:
                continue
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        errors.append(f"infrastructure: {error}")
    finally:
        parent = processes["host"]
        if parent is not None and parent.stdin is not None:
            try:
                parent.stdin.close()
            except OSError as error:
                cleanup_errors.append(f"host supervisor lifeline close failed: {error}")
        # Service both handles independently even when the observer has already exited.
        for role in ("observer", "host"):
            stop_geometry_process(processes[role], role, cleanup_errors, grace)
        for stream in logs:
            try:
                stream.close()
            except OSError as error:
                cleanup_errors.append(f"geometry log close failed: {error}")
        launch = {"schema": "minga-approval-geometry-launch-v2", **common, **{
            role: geometry_process_record(processes[role], executables[role], groups[role]) for role in processes
        }}
        expected = {**common, **{
            role: geometry_process_record(processes[role], executables[role], groups[role], cleanup=True) for role in processes
        }}
        closed = all(stream.closed for stream in logs) and (parent is None or parent.stdin is None or parent.stdin.closed)
        cleanup = {"schema": "minga-approval-geometry-cleanup-v1", **expected, "descriptors_closed": closed, "errors": cleanup_errors}
        errors.extend(f"infrastructure: {error}" for error in cleanup_errors)
        receipt.update({"launch": launch, "cleanup": cleanup, "exit_code": processes["observer"].returncode if processes["observer"] is not None else None})
        try:
            (case / "launch.json").write_text(json.dumps(launch, indent=2) + "\n")
            (case / "cleanup.json").write_text(json.dumps(cleanup, indent=2) + "\n")
            lifecycle_errors = validate_geometry_lifecycle(geometry_json(case / "launch.json"), geometry_json(case / "cleanup.json"), expected)
            errors.extend(lifecycle_errors)
            receipt["cleanup_verified"] = not lifecycle_errors
        except (OSError, ValueError) as error:
            errors.append(f"infrastructure: could not retain lifecycle evidence: {error}")
        try:
            if processes["observer"] is not None and processes["host"] is not None:
                value = geometry_json(case / "observation.json")
                validation, captured = validate_geometry_observation(value, case, receipt["run_id"], receipt["width"], processes["observer"].pid, observer, host, processes["host"].pid)
                errors.extend(validation)
                receipt["captured"] = captured
                receipt["observed"] = value.get("kind") == "observation" and not any(error.startswith("infrastructure:") for error in errors)
            if receipt["exit_code"] != 0:
                errors.append(f"infrastructure: observer did not finish acquisition successfully: {receipt['exit_code']}")
        except (OSError, ValueError) as error:
            errors.append(f"infrastructure: {error}")
        receipt["success"] = not errors and receipt["observed"] and receipt["captured"] and receipt["cleanup_verified"]
        try:
            (case / "case-receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        except OSError as error:
            errors.append(f"infrastructure: could not retain case receipt: {error}")
            receipt["success"] = False


def approval_geometry_action(run):
    return {
        "name": "approval-geometry", "summary": None, "tests": None, "test_process_ids": [],
        "success": False, "executed": False, "exit_code": 125, "seconds": 0,
        "log": str((run / "approval-geometry.log").relative_to(run.parent)), "validation_errors": [], "cases": [],
        "attempted_widths": [], "observed_widths": [], "captured_widths": [], "passed_widths": [],
    }


def run_approval_geometry(root, products, run, action):
    started = time.monotonic()
    log = run / "approval-geometry.log"
    errors = action["validation_errors"]
    try:
        sources = [root / name for name in ("macos/Sources", "macos/TestSupport", "macos/.generated", "macos/project.yml", "macos/Minga.xcodeproj/project.pbxproj", "scripts/test_macos_unit")]
        before = geometry_manifest(sources)
        command = ["xcodebuild", "build", "-project", "Minga.xcodeproj", "-scheme", "MingaApprovalGeometry", "-configuration", "Debug", "-derivedDataPath", str(products.parent.parent), "CODE_SIGNING_ALLOWED=NO", "-destination", "platform=macOS"]
        action["command"], action["executed"] = command, True
        with log.open("w") as stream:
            action["exit_code"] = subprocess.run(command, cwd=root / "macos", stdout=stream, stderr=subprocess.STDOUT, check=False, timeout=300).returncode
        if action["exit_code"] != 0:
            raise ValueError(f"Geometry host/observer build exited {action['exit_code']}; log={log}")
        if before != geometry_manifest(sources):
            raise ValueError("Geometry source/build graph changed during the build")
        observer = products / "Debug/minga-approval-geometry"
        app = products / "Debug/MingaTestHost.app"
        host = app / "Contents/MacOS/MingaTestHost"
        if not os.access(observer, os.X_OK) or not os.access(host, os.X_OK):
            raise ValueError("Current geometry host/observer executable is missing")
        artifacts = geometry_manifest([observer, app, products / "Debug/MingaUI.framework"])
        action["source_manifest"], action["product_manifest"] = before, artifacts
        evidence = run / "approval-geometry"
        evidence.mkdir()
        cancelled, previous = [None], {}

        def record_cancellation(signum, _frame):
            if cancelled[0] is None:
                cancelled[0] = signum

        try:
            for signum in (signal.SIGINT, signal.SIGTERM):
                previous[signum] = signal.getsignal(signum)
                signal.signal(signum, record_cancellation)
            for width in GEOMETRY_WIDTHS:
                receipt = {"width": width, "run_id": str(uuid.uuid4()), "validation_errors": [], "exit_code": None}
                action["cases"].append(receipt)
                action["attempted_widths"].append(width)
                run_geometry_case(evidence / str(width), receipt, observer, host, lambda: cancelled[0])
                for field, observed in (("observed_widths", "observed"), ("captured_widths", "captured"), ("passed_widths", "success")):
                    if receipt[observed]:
                        action[field].append(width)
                errors.extend(f"{width}: {error}" for error in receipt["validation_errors"])
                if cancelled[0] is not None:
                    raise ValueError(f"Geometry cancelled by signal {cancelled[0]}; all owned children serviced")
                if not receipt["cleanup_verified"]:
                    raise ValueError(f"Geometry {width} did not prove complete owned cleanup; no further host launched")
        finally:
            for signum, handler in previous.items():
                signal.signal(signum, handler)
        if before != geometry_manifest(sources) or artifacts != geometry_manifest([observer, app, products / "Debug/MingaUI.framework"]):
            raise ValueError("Geometry source/build products changed during observation")
        if action["passed_widths"] != list(GEOMETRY_WIDTHS):
            errors.append("assertion: all three real workspace widths must pass with retained captures")
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        errors.append(f"infrastructure: {error}")
    finally:
        action["seconds"] = time.monotonic() - started
        action["success"] = not errors and action["passed_widths"] == list(GEOMETRY_WIDTHS)
    return action


def save_results(output, actions, started):
    def total(key):
        return sum(action["summary"][key] for action in actions if action["name"] != "approval-geometry" and isinstance(action["summary"], dict) and type(action["summary"].get(key)) is int)

    geometry = next((action for action in actions if action["name"] == "approval-geometry"), {})
    geometry_ready = geometry.get("summary") is None and geometry.get("tests") is None and all(
        geometry.get(key) == list(GEOMETRY_WIDTHS) for key in ("attempted_widths", "observed_widths", "captured_widths", "passed_widths")
    )
    result = {
        "actions": actions,
        "total_passed_tests": total("passedTests"),
        "total_failed_tests": total("failedTests"),
        "seconds": time.monotonic() - started,
        "success": {action["name"] for action in actions} == {"ordinary", "focus-policy", "focus-replay", "approval-geometry"} and len(actions) == 4 and all(action["success"] for action in actions) and geometry_ready,
    }
    (output / "results.json").write_text(json.dumps(result, indent=2) + "\n")
    return result


def main():
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output-dir", type=Path, default=root / "macos-unit-evidence", help="Retained logs, xcresults, and results.json")
    args = parser.parse_args()
    output = args.output_dir.resolve()
    output.mkdir(parents=True, exist_ok=True)
    run = Path(tempfile.mkdtemp(prefix="run-", dir=output))
    common = ["-project", "Minga.xcodeproj", "-scheme", "MingaUnitTests", "-configuration", "Debug", "-derivedDataPath", str(root / "macos/DerivedData"), "CODE_SIGNING_ALLOWED=NO"]
    # Separate processes preserve focus isolation; geometry uses an external UI consumer.
    selections = [
        ("ordinary", "test", ["-only-testing:MingaTests", f"-skip-testing:MingaTests/{POLICY}", f"-skip-testing:MingaTests/{REPLAY}"]),
        ("focus-policy", "test-without-building", [f"-only-testing:MingaTests/{POLICY}"]),
        ("focus-replay", "test-without-building", [f"-only-testing:MingaTests/{REPLAY}"]),
    ]
    started = time.monotonic()
    actions = []
    products = root / "macos/DerivedData/Build/Products"
    pinned_plan = run / "focus-replay.xctestrun"
    hosted_settings, hosted_receipt = None, {}
    policy_plan = None
    save_results(output, actions, started)
    try:
        for name, operation, selectors in selections:
            bundle = run / f"{name}.xcresult"
            log = run / f"{name}.log"
            overrides = ["TEST_HOST=", "BUNDLE_LOADER="] if name == "ordinary" else []
            command = ["xcodebuild", operation, *common, *overrides, *selectors, "-resultBundlePath", str(bundle)]
            if name != "ordinary":
                input_plan = run / f"{name}.xctestrun"
                command = ["xcodebuild", operation, "-xctestrun", str(input_plan), "-destination", "platform=macOS", *selectors, "-resultBundlePath", str(bundle)]
            action_started = time.monotonic()
            receipt = dict(hosted_receipt) if name == "focus-replay" else {}
            preparation_errors = []
            if name == "focus-policy":
                hosted_settings, receipt, preparation_errors, policy_plan = prepare_hosted_policy(common, products, run, root / "macos")
            executed = name == "ordinary" or (name == "focus-policy" and not preparation_errors) or (name == "focus-replay" and actions[1]["success"] and pinned_plan.is_file())
            action = {
                "name": name, "command": command, "exit_code": 125, "seconds": 0,
                "summary": None, "tests": None, "log": str(log.relative_to(output)),
                "result_bundle": str(bundle.relative_to(output)), "validation_errors": preparation_errors,
                "test_process_ids": [], "success": False, "executed": False, "execution_identity": receipt,
            }
            actions.append(action)
            save_results(output, actions, started)
            with log.open("w") as stream:
                if not executed:
                    stream.write(f"{name} dependency failed: no verified current successful hosted {'build' if name == 'focus-policy' else 'policy execution'}\n")
                    exit_code = 125
                else:
                    try:
                        exit_code = subprocess.run(command, cwd=root / "macos", stdout=stream, stderr=subprocess.STDOUT, check=False).returncode
                    except OSError as error:
                        stream.write(str(error) + "\n")
                        exit_code = 127
            summary = extract_result(bundle, "summary", run / f"{name}.summary.json") if bundle.is_dir() else None
            tests = extract_result(bundle, "tests", run / f"{name}.tests.json") if bundle.is_dir() else None
            errors, pids = validate_action(name, summary, tests, log.read_text(errors="replace"), exit_code)
            errors = preparation_errors + errors
            if not executed:
                errors.append(f"{name} dependency failed: no verified current successful hosted {'build' if name == 'focus-policy' else 'policy execution'}")
            if name == "ordinary":
                settings_path = run / f"{name}.build-settings.json"
                probe, settings = capture_build_settings(common, overrides, settings_path, root / "macos")
                receipt.update({"settings": str(settings_path.relative_to(output)), "settings_command": probe["command"], "settings_probe": probe})
                if probe["error"]:
                    errors.append(f"{name}: {probe['error']}; JSON={probe['stdout']}; stderr={probe['stderr']}")
            else:
                settings = hosted_settings
            errors.extend(validate_execution_identity(settings, log.read_text(errors="replace"), products, name != "ordinary"))
            if name == "focus-policy":
                if not errors:
                    try:
                        pin_focus_plan(policy_plan, products, pinned_plan, REPLAY)
                        receipt["replay_plan"] = str(pinned_plan.relative_to(output))
                    except (ValueError, OSError) as error:
                        errors.append(f"Could not pin replay from the accepted policy input: {error}")
                hosted_receipt = receipt
            if not bundle.is_dir():
                errors.append("No xcresult bundle was produced; inspect the retained test log")
            action.update({
                "exit_code": exit_code, "seconds": time.monotonic() - action_started,
                "summary": summary, "tests": tests,
                "validation_errors": errors, "test_process_ids": pids, "success": not errors,
                "executed": executed,
            })
            if name == "focus-replay":
                policy_pids = actions[1]["test_process_ids"]
                if pids and set(pids) & set(policy_pids):
                    action["validation_errors"].append("Focus suites reused the same test-runner PID")
                    action["success"] = False
            save_results(output, actions, started)
            print(f"{'PASS' if action['success'] else 'FAIL'} {name}: xcresult: {bundle}\nTest log: {log}")
            for error in action["validation_errors"]:
                print(error)
        geometry = approval_geometry_action(run)
        actions.append(geometry)
        save_results(output, actions, started)
        # A standalone host build must not replace the hosted products consumed by later replay.
        geometry_products = root / "macos/DerivedData/ApprovalGeometry/Build/Products"
        run_approval_geometry(root, geometry_products, run, geometry)
        if actions[2]["success"]:
            geometry["validation_errors"].extend(
                f"infrastructure: geometry changed the hosted replay product: {error}"
                for error in validate_build_identity(hosted_settings, products, True)
            )
            geometry["success"] = geometry["success"] and not geometry["validation_errors"]
        print(f"{'PASS' if geometry['success'] else 'FAIL'} approval-geometry: actual widths: {geometry['passed_widths']}\nGeometry log: {geometry['log']}")
        for error in geometry["validation_errors"]:
            print(error)
    finally:
        result = save_results(output, actions, started)
        print(f"Native unit results: {output / 'results.json'}")
    return 0 if result["success"] else 1


if __name__ == "__main__":
    sys.exit(main())

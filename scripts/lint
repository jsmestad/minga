#!/usr/bin/env bash
# Local gate behind `make lint` (fast), `make lint.full`, and `make done`.
#
# Independent checks run concurrently. Each check writes to its own log, and the logs are replayed in a fixed order once everything finishes, so output stays readable and deterministic. Independent checks all run even when one fails; only the checks that need BEAM files (Dialyzer, Reach) are skipped when compile fails.
#
# fast: format, changed-file Credo, ExDNA                      (no compile, run in parallel)
#       compile -> incremental Dialyzer + Reach arch policy     (followers run in parallel once compile passes)
#       When no Elixir-relevant file changed against the base ref (docs-only branches), the compile chain and ExDNA are skipped.
# full: format, full Credo, ExDNA                              (no compile, run in parallel)
#       compile -> classic Dialyzer + Reach arch and smells     (followers run in parallel once compile passes)
# done: fast lint, then the non-heavy ExUnit suite, then Swift build and MingaTests when macOS inputs changed.
set -uo pipefail

mode=${1:-fast}
case "$mode" in
  fast|full|done) ;;
  *)
    echo "usage: scripts/lint [fast|full|done]" >&2
    exit 2
    ;;
esac

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
source scripts/lib/changed_files.sh
if [ "$mode" != full ]; then
  changed=$(changed_files) || exit 2
fi

if [ -t 1 ]; then
  red=$'\033[31m'; green=$'\033[32m'; dim=$'\033[2m'; bold=$'\033[1m'; reset=$'\033[0m'
else
  red=""; green=""; dim=""; bold=""; reset=""
fi

# Preflight: a toolchain other than the .tool-versions pin silently recompiles every dependency (about 60s) and cold-starts the incremental Dialyzer cache (about 3 minutes). Fail fast instead.
pinned_elixir=$(awk '$1 == "elixir" { sub(/-otp-.*/, "", $2); print $2 }' .tool-versions)
active_elixir=$(elixir --short-version 2>/dev/null)
if [ -n "$pinned_elixir" ] && [ "$pinned_elixir" != "$active_elixir" ]; then
  echo "${red}Toolchain mismatch:${reset} active Elixir $active_elixir, .tool-versions pins $pinned_elixir ($(command -v elixir))." >&2
  echo "Put the asdf shims ahead of other Elixir installs on PATH, or run from a shell that resolves the pinned toolchain." >&2
  exit 2
fi

log_dir=$(mktemp -d "${TMPDIR:-/tmp}/minga-lint.XXXXXX")
trap 'rm -rf "$log_dir"' EXIT

# Insertion order is the report order.
names=()
status_of() { cat "$log_dir/$1.status" 2>/dev/null || echo 1; }

# run NAME CMD... : run one check in the background, capturing output and exit status.
run() {
  local name=$1
  shift
  names+=("$name")
  (
    start=$(date +%s)
    "$@" >"$log_dir/$name.log" 2>&1
    rc=$?
    echo $rc >"$log_dir/$name.status"
    echo $(( $(date +%s) - start )) >"$log_dir/$name.seconds"
  ) &
}

# skip NAME REASON : record a check as intentionally not run.
skip() {
  names+=("$1")
  echo "skipped: $2" >"$log_dir/$1.log"
  echo skip >"$log_dir/$1.status"
  echo 0 >"$log_dir/$1.seconds"
}

# chain NAME1 CMD1 [NAME CMD]... : run CMD1, then every following command concurrently, only when CMD1 succeeds. One background job.
chain() {
  local first=$1 first_cmd=$2
  shift 2
  local followers=("$@")
  names+=("$first")
  local i
  for ((i = 0; i < ${#followers[@]}; i += 2)); do
    names+=("${followers[i]}")
  done
  (
    start=$(date +%s)
    bash -c "$first_cmd" >"$log_dir/$first.log" 2>&1
    rc=$?
    echo $rc >"$log_dir/$first.status"
    echo $(( $(date +%s) - start )) >"$log_dir/$first.seconds"
    if [ $rc -ne 0 ]; then
      for ((i = 0; i < ${#followers[@]}; i += 2)); do
        echo "$first failed, no BEAM files to analyze" >"$log_dir/${followers[i]}.log"
        echo skip >"$log_dir/${followers[i]}.status"
        echo 0 >"$log_dir/${followers[i]}.seconds"
      done
      exit
    fi
    for ((i = 0; i < ${#followers[@]}; i += 2)); do
      (
        name=${followers[i]} cmd=${followers[i + 1]}
        start=$(date +%s)
        bash -c "$cmd" >"$log_dir/$name.log" 2>&1
        echo $? >"$log_dir/$name.status"
        echo $(( $(date +%s) - start )) >"$log_dir/$name.seconds"
      ) &
    done
    wait
  ) &
}

# Keep Swift artifacts outside the disposable lint logs so failures remain inspectable.
swift_build() {
  mix swift.build >"$MINGA_DONE_DIR/swift-build.log" 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'Swift build failed. Build log: %s/swift-build.log\n' "$MINGA_DONE_DIR"
  fi
  return "$rc"
}

swift_test() {
  scripts/test_macos_unit --output-dir "$MINGA_DONE_DIR/native-unit"
}

run format mix format --check-formatted
if [ "$mode" = full ]; then
  run credo mix credo --strict
else
  run credo scripts/credo_changed
fi

if [ "$mode" = full ]; then
  run ex-dna mix ex_dna --max-clones 0
  chain compile "mix compile --warnings-as-errors" \
    dialyzer "mix dialyzer" \
    reach "mix reach.check --arch --smells"
elif elixir_changed "$changed"; then
  run ex-dna mix ex_dna --max-clones 0
  chain compile "mix compile --warnings-as-errors" \
    dialyzer "mix dialyzer.incremental" \
    reach "mix reach.check --arch"
else
  skip ex-dna "no Elixir-relevant file changed"
  skip compile "no Elixir-relevant file changed"
  skip dialyzer "no Elixir-relevant file changed"
  skip reach "no Elixir-relevant file changed"
fi

wait

if [ "$mode" = done ]; then
  run test.llm mix test.llm
  wait

  if ! macos_changed "$changed"; then
    skip swift.build "no macOS-relevant file changed"
    skip swift.test "no macOS-relevant file changed"
  elif ! command -v xcodebuild >/dev/null 2>&1; then
    skip swift.build "xcodebuild not found"
    skip swift.test "xcodebuild not found"
  else
    if {
      MINGA_DONE_DIR=${MINGA_DONE_DIR:-$(mktemp -d "${TMPDIR:-/tmp}/minga-done.XXXXXX")} &&
        mkdir -p "$MINGA_DONE_DIR" &&
        MINGA_DONE_DIR=$(cd "$MINGA_DONE_DIR" && pwd -P)
    } >"$log_dir/swift-setup.log" 2>&1; then
      run swift.build swift_build
    else
      run swift.build bash -c 'cat "$1"; exit 1' bash "$log_dir/swift-setup.log"
    fi
    wait
    if [ "$(status_of swift.build)" = 0 ]; then
      run swift.test swift_test
      wait
    else
      skip swift.test "swift.build failed"
    fi
  fi
fi

failed=""
for name in "${names[@]}"; do
  rc=$(status_of "$name")
  seconds=$(cat "$log_dir/$name.seconds" 2>/dev/null || echo "?")
  case "$rc" in
    0)    printf '%s[pass]%s %-9s %4ss\n' "$green" "$reset" "$name" "$seconds" ;;
    skip) printf '%s[skip]%s %-9s %4ss (%s)\n' "$dim" "$reset" "$name" "$seconds" "$(cat "$log_dir/$name.log")" ;;
    *)
      failed="$failed $name"
      printf '%s[FAIL]%s %-9s %4ss\n' "$red" "$reset" "$name" "$seconds"
      ;;
  esac
done

for name in "${names[@]}"; do
  rc=$(status_of "$name")
  # Failed checks print in full. A passing compile also prints when it emitted compiler warnings, since those become errors in CI.
  if [ "$rc" != 0 ] && [ "$rc" != skip ]; then
    printf '\n%s── %s (exit %s) ──%s\n' "$bold" "$name" "$rc" "$reset"
    cat "$log_dir/$name.log"
  elif [ "$name" = compile ] && grep -q -E '^\s*warning:' "$log_dir/$name.log"; then
    printf '\n%s── %s (passed with warnings) ──%s\n' "$bold" "$name" "$reset"
    cat "$log_dir/$name.log"
  fi
done

if [ -n "$failed" ]; then
  printf '\n%sFailed checks:%s%s\n' "$red" "$failed" "$reset"
  exit 1
fi

if [ "$mode" = done ]; then
  printf '\n%sAll local review checks passed.%s\n' "$green" "$reset"
else
  printf '\n%s%s lint checks passed.%s\n' "$green" "$mode" "$reset"
fi
